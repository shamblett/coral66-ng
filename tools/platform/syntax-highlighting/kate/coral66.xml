    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <!-- Comments -->
        <WordDetect attribute="Comment" context="Comment" String="COMMENT" insensitive="false"/>
        <StringDetect attribute="Comment" context="Comment" String="'COMMENT'" insensitive="false"/>

        <!-- END Comment -->
        <WordDetect attribute="Keyword" context="EndComment" String="END" />
        <StringDetect attribute="Keyword" context="EndComment" String="'END'" />

        <!-- Semicolon tracking for bracketed comments -->
        <DetectChar attribute="Symbol" context="AfterSemicolon" char=";" />

        <!-- Keywords, Types, Operators, Booleans -->
        <keyword attribute="Keyword" context="#stay" String="keywords" />
        <keyword attribute="Data Type" context="#stay" String="types" />
        <keyword attribute="Operator" context="#stay" String="operators" />
        <keyword attribute="Value" context="#stay" String="booleans" />

        <!-- Strings -->
        <DetectChar attribute="String" context="String" char="&quot;" />

        <!-- Numbers -->
        <!-- Float matching e.g. 1.0, .5, 3. -->
        <RegExpr attribute="Float" context="#stay" String="\b\d*\.\d+\b|\b\d+\.\b" />
        <!-- Exponent keyword 10 (stand-alone) -->
        <WordDetect attribute="Keyword" context="#stay" String="10" />
        <!-- Integer matching -->
        <RegExpr attribute="Decimal" context="#stay" String="\b\d+\b" />

        <!-- Symbols -->
        <AnyChar attribute="Symbol" context="#stay" String="+-*/=&lt;&gt;:=[]()," />
        
        <!-- Identifiers -->
        <RegExpr attribute="Normal Text" context="#stay" String="[a-zA-Z][a-zA-Z0-9]*" />
      </context>

      <!-- Comment Context: until a semicolon -->
      <context name="Comment" attribute="Comment" lineEndContext="#stay">
        <DetectChar attribute="Comment" context="#pop" char=";" />
      </context>

      <!-- END Comment Context: matches a single identifier following END -->
      <context name="EndComment" attribute="Normal Text" lineEndContext="#pop" fallthrough="true" fallthroughContext="#pop">
        <DetectSpaces />
        <RegExpr attribute="Comment" context="#pop" String="[a-zA-Z][a-zA-Z0-9]*" />
      </context>

      <!-- After Semicolon Context: checks for bracketed comments -->
      <context name="AfterSemicolon" attribute="Normal Text" lineEndContext="#stay" fallthrough="true" fallthroughContext="#pop">
        <DetectSpaces />
        <DetectChar attribute="Comment" context="BracketedComment" char="(" />
        <!-- If it's a COMMENT keyword immediately after semicolon, handle it by popping and letting Normal match it -->
        <WordDetect attribute="Comment" context="#pop!Comment" String="COMMENT" insensitive="false"/>
        <StringDetect attribute="Comment" context="#pop!Comment" String="'COMMENT'" insensitive="false"/>
      </context>

      <!-- Bracketed Comment Context: matches matching parenthesis -->
      <context name="BracketedComment" attribute="Comment" lineEndContext="#stay">
        <DetectChar attribute="Comment" context="#pop#pop" char=")" />
        <DetectChar attribute="Comment" context="BracketedComment" char="(" />
      </context>

      <!-- String Context -->
      <context name="String" attribute="String" lineEndContext="#stay">
        <!-- Strings can contain escaped quotes (e.g., "") in some dialects, but standard Coral 66 doesn't specify. We just detect the closing quote -->
        <DetectChar attribute="String" context="#pop" char="&quot;" />
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal" />
      <itemData name="Keyword" defStyleNum="dsKeyword" />
      <itemData name="Data Type" defStyleNum="dsDataType" />
      <itemData name="Operator" defStyleNum="dsOperator" />
      <itemData name="Value" defStyleNum="dsConstant" />
      <itemData name="Comment" defStyleNum="dsComment" />
      <itemData name="String" defStyleNum="dsString" />
      <itemData name="Decimal" defStyleNum="dsDecVal" />
      <itemData name="Float" defStyleNum="dsFloat" />
      <itemData name="Symbol" defStyleNum="dsOperator" />
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="multiLine" start="COMMENT" end=";" />
    </comments>
    <keywords casesensitive="1" />
  </general>
