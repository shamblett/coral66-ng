'comment'  ----------------------------------------------------------------
 -
 -  Filename:
 -
 -     ackermann.cor
 -
 -  Description:
 -
 -     Ackermann's function "is an example of a recursive function which 
 -     is not primitive recursive". It is interesting from the point of 
 -     view of benchmarking because it "grows faster thany any primitive 
 -     recursive function" and gives us a lot of nested function calls
 -     for little effort.
 -     
 -     It is defined as follows:
 -        Ackermann(0, n) = n+1 
 -        Ackermann(m, 0) = Ackermann(m-1, 1) 
 -        Ackermann(m, n) = Ackermann(m-1, Ackermann(m, n-1)) 
 -
 -     We use Ackermann(3,6) as the benchmark. This used to take long enough to 
 -     confirm the execution time with a stopwatch. Nowadays that's out
 -     of the question. BTW, the value of Ackermann(4,2) has 19729 digits!
 -
 -     Ackermann (3,6) gives us 172233 calls, with a nesting depth of 511. But
 -     beware of tail recursion optimization.
 -
 -  Credits:
 -
 -     Ackermann's function is named after Wilhelm Ackermann, a 
 -     mathematical logician who worked in Germany during the first half
 -     of the 20th century.
 -
 -  Revision:
 -
 -     $Id: ackermann.c,v $
 -
 --------------------------------------------------------------------------;

'common'(
   'procedure' test    ('value''integer', 'value''integer');
   'procedure' comment ('value''integer');
   'procedure' failed  ('value''integer');
   'procedure' result;
)

'common' (
   'procedure' outchar ('value''integer','value''integer');
   'procedure' outstring ('value''integer','value''integer');
   'procedure' outinteger ('value''integer','value''integer');
   'procedure' outnewline ('value''integer');
)

'include' "time.cor";

'begin'
   'integer' ans;
   'long''integer' starttime, stoptime;


   'integer''recursive' Ackermann ('value''integer' m, n);
   'begin'
      'if' m = 0 'then' 
         'answer' n + 1 
      'else''if' n = 0 'then' 
         'answer' Ackermann (m - 1, 1)
      'else' 
         'answer' Ackermann (m - 1, Ackermann (m, n - 1));
   'end' Ackermann;


   test ("ackermann", "Function call benchmark, Ackermann (3, 6)");

   starttime := clock;
   ans := Ackermann (3,6);
   stoptime := clock;

   'if' ans <> 509 'then'
      failed ("Answer wrong, correct answer is 509");

   outstring (1, "Time taken = ");
   outinteger (1, 1000 * (stoptime - starttime) / CLOCKS PER SEC);
   outstring (1, " milliseconds");
   outnewline (1);

   result
'end' main


