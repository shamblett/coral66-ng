;
	.SBTTL	CONTROL CONSTANTS
;
	RT11	=	1		;RT11 STATUS FLAG
	IAS	=	2		;IAS STATUS FLAG
	ALONE	=	4		;STAND ALONE SYSTEM
;
	OPSYS	=	IAS		;OPERATING SYSTEM IS (IAS)
	MACHINE	=	70		;MACHINE TYPE IS AN 11/70
;
	VDUSIZE	=	80.		;VDU INPUT BUFFER SIZE
;
	EOT	=	4		;END OF TAPE SIGNAL PDP
	CNTD	=	'D-100		;HERMES END OF TEXT MARKER
	CNTZ	=	'Z-100		;PDP END OF TEXT MARKER
	TAB	=	11		;VALUE FOR A TAB CHARACTER
	LF	=	12		;VALUE FOR LINE FEED
	FF	=	14		;VALUE FOR FORM FEED
	CR	=	15		;VALUE FOR CARRAGE RETURN
	ESC	=	33		;VALUE FOR AN ESCAPE CHARACTER
	SPACE	=	40		;VALUE FOR A SPACE CHARACTER
	ERASE	=	177		;VALUE FOR AN ERASE CHARACTER
	PARITY	=	200		;PARITY BIT FOR BYTE OPERATIONS
;
;
	.SBTTL	EXTERNAL MACRO CALL SECTION
;
	.MCALL	GENMAC
	GENMAC		;Get the general macros.
	.MCALL	SUPMAC
	SUPMAC		;Get the 'Super Mac' macros.
;
;
;
	LIST		;Causes listing of macro generated code.(NOLIST)
;
;	TRACE		;Is used for runtime debugging.(NOTRACE)
;
;
;
	.SBTTL	DEFAULT MACRO COMPLIER SETTINGS
;
;
	.ENABL	LC
	.ENABL	GBL
;
;
;
;
