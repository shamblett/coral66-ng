	.TITLE	ML04..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML04../
;
	.SBTTL	.		CHARACTER DELETE WITHIN A STRING.
;
L$DELETE::
;
;	ENTRY CONDITIONS
;
;	CD.SRC	->	STRING TO PROCESS
;	CD.POS	=	START POSITION WHERE DELETING IS TO START.
;	CD.CNT	=	NUMBER OF CHARACTERS TO DELETE.
;
;	EXIT CONDITIONS
;
;	NONE
;
	CALL	R$SAVE
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	MOV	CD.CNT,R3
	CALL	R$DELETE
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
