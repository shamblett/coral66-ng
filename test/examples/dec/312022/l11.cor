   'CORAL' L11
   'LIBRARY' (
 
   'COMMENT' BASIC COMPATABLE PROCEDURES;
 
 
   'PROCEDURE' READREC('VALUE''BYTE','BYTE''ARRAY','VALUE''INTEGER','LOCATION''INTEGER','LABEL','LABEL'));
   'COMMON' ('INTEGER''PROCEDURE' FILEIN ('VALUE''BYTE'));
 
   'COMMENT' GENERAL CORAL DEFINITIONS;
   'INCLUDE' "[200,25]GENDEF.COR"
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' FILEIN ('VALUE''BYTE' FILE);
       'BEGIN'
           'BYTE''ARRAY' DATA [0:999]:=0;
           'OVERLAY' DATA[0] 'WITH' 'INTEGER' MAXLEN;
           'OVERLAY' DATA[2] 'WITH' 'INTEGER' LENGTH;
           'OVERLAY' DATA[4] 'WITH' 'BYTE''ARRAY' STRING[0:995];
           MAXLEN := 990;  (FIX MAXIMUM LENGTH)
           READREC(FILE,STRING,990,LENGTH,ERRL,EOFL);
           'ANSWER' 'LOCATION' (DATA[2]);
 EOFL:     'ANSWER' EOF;
 ERRL:     'ANSWER'ERROR;
       'END';
   'END';
   'FINISH'
