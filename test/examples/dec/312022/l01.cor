   'CORAL' L1
 
 
   'COMMON' ('INTEGER''PROCEDURE' LEN('VALUE''INTEGER'));
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' LEN('VALUE''INTEGER' STRING);
       'BEGIN'
 
           'COMMENT' REPLY WITH VALUE OF STRING LENGTH
                     NOTE VALUE IS HELD IN FIRST LOCATION OF STRING;
           'ANSWER'[STRING+0];
       'END';
   'END';
   'FINISH'
