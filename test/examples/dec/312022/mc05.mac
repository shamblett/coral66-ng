	.TITLE	MC05.. STRING PROCEDURES FOR CORAL IN MACRO
;
	.IDENT	/MC05../
;
	.PAGE
	.SBTTL	LOCATE POSITION OF ONE CHARACTER STRING IN ANOTHER (POS)
;
POS::
LPOS::
	SAVE R1,R2		;SAVE R1 AND R2
;
	MOV 2(R5),R0			;MASTER STRING ADDRESS
	CALL R$ADDRESS			;CHECK IF ADDRESS VALID
	IFERROR	140$			;J IF ADDRESS INVALID
	MOV R0,R1			;HOLD MASTER ADDRESS
;
	MOV 4(R5),R0			;SUB STRING ADDRESS
	CALL R$ADDRESS			;CHECK IF ADDRESS VALID
	IFERROR 140$			;J IF ADDRESS INVALID
	MOV R0,R2			;HOLD SUB STRING ADDRESS
;
	MOV 6(R5),R0			;HOLD START POSTION IN STRING
	BLE	140$			;J IF START POSITION <=0
;
	CALL R$POS3			;LOCATE CHARACTER POSITION
	BR	150$			;EXIT WITH POSITION VALUE
;
140$:	CLR R0				;INDICATE SEARCH FAILED
;
150$:					;SUCCESS EXIT R0 POINTS TO MATCH POS
	UNSAVE R1,R2			;RESTORE R1 AND R2
;
;	PROGRAM EXIT
	RETURN				;RETURN TO CALLING PROGRAM
;
;
	.END
;
;
