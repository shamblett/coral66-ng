	.TITLE	ML14..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML14../
;
	.SBTTL	.		EXTRACT SEGMENT OF A CHARACTER STRING.
;
L$SEG::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	INPUT STRING ADDRESS.
;	CD.POS	->	START POSITION.
;	CD.CNT	->	NUMBER OF CHARACTERS.
;	CD.DST	->	OUTPUT CHARACTER STRING ADDRESS.
;
;	EXIT CONDITIONS
;
;	CD.DST ->	OUTPUT STRING ADDRESS.
;
	CALL	R$SAVE
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	MOV	CD.CNT,R3
	ADD	R2,R3
	MOV	CD.DST,R4
	CALL	R$SEG
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
