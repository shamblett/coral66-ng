	.PAGE
	.SBTTL	.	PRINT
;
.MACRO	PRINT C,TEXT,?D
;
;	ENTRY CONDITIONS
;
;	PRINT			;R0 -> STRING
;	PRINT ADDRESS		;ADDRESS POINTS TO STRING
;	PRINT ADDRESS,STRING	;PRINT STRING ADDRESS ALLOCATED TO STRING
;	PRINT ,STRING		;PRINT STRING NO ALLOCATED ADDRESS
;
	.NARG	NARG
				;IF NO PARAMETERS ASSUME STRING ADDRESS IN R0
.IIF EQ NARG  .EMIT <CALL V$TX	;OUTPUT STRING>
;
;
.IF EQ	NARG-1			;IS THE A ONE PARAMETER OPTION
				;THE ADDRESS OF DATA HELD IN ADDRESS PARAMETER
	.EMIT	<MOV R0,-(SP)	;SAVE CONTENTS OF REGISTER ZERO>
	.NTYPE	NTYPE,C		;HOLD ADDRESS TYPE OF PARAMETER TWO
	.IIF EQ NTYPE-27 .EMIT	<MOV C,R0>
	.IIF EQ	NTYPE-67 .EMIT	<MOV #C,R0>
	.IIF EQ NTYPE-77 .EMIT	<MOV #C,R0>
	.IIF NE NTYPE&7-7 .EMIT	<MOV C,R0>
	.IIF	EQ	LST$$	.LIST
		CALL V$TX	;OUTPUT MESSAGE
		MOV (SP)+,R0	;RESTORE REGISTER R0
	.IIF	EQ	LST$$	.NLIST
.ENDC
;
;
.IF EQ	NARG-2				;HAVE TWO PARAMETERS BEEN PASSED
;
;		SITUATION
;	PRINT REQUEST WITH A TEXT MESSAGE AND OPTIONAL LABLE ATTACHED
;
.IF B C
.IFF
	.IIF	EQ	LST$$	.LIST
		CALL V$TXD
		.WORD 0			;PROTECTION WORD
C:		.WORD D-.-2		;HOLD LENGTH OF STRING
	.IIF	EQ	LST$$	.NLIST
.IFT
	.IIF	EQ	LST$$	.LIST
		CALL V$TXB
		.WORD D-.-2		;HOLD LENGTH OF STRING
	.IIF	EQ	LST$$	.NLIST
.IFTF
	.IIF	EQ	LST$$	.LIST
		.ASCII	TEXT		;STORE DATA
D:		.EVEN			;SET TO EVEN BOUNDRY
	.IIF	EQ	LST$$	.NLIST
;
;
.ENDC
.ENDC
.ENDM	PRINT
;
;
;
;
	.SBTTL	.	PRINT CHARACTER
;
;
;
.MACRO	PRINTC ?A,?B
;
;	ENTRY CONDITIONS
;
;	PRINT			;R0 = CHARACTER
;	PRINT CHARACTER		;LOCATION HOLD CHARACTER
;
	.NARG	NARG
				;IF NO PARAMETERS ASSUME CHARACTER IN R0
.IIF EQ NARG .EMIT <MOVB R0,B>	;LOAD CHARACTER INTO WORK STRING
;
.IF EQ	NARG-1			;IS THE A ONE PARAMETER OPTION
	.NTYPE NTYPE,A		;HOLD ADDRESSING TYPE OF PARAMETER
	.IIF EQ NTYPE-27 .EMIT	<MOVB A,B>
	.IIF EQ	NTYPE-67 .EMIT	<MOVB #A,B>
	.IIF EQ NTYPE-77 .EMIT	<MOVB #A,B>
	.IIF NE NTYPE&7-7 .EMIT	<MOVB A,B>
.ENDC
	.IIF	EQ	LST$$	.LIST
		CALL	V$TXC	;REPEAT SINGLE CHARACTER TRANSFER ROUTINE
		.BYTE	1	;ONE REPEATED CHARACTER
B:		.BYTE	0	;NEW CHARACTER TO BE OUTPUT
	.IIF	EQ	LST$$	.NLIST
;
.ENDM	PRINTC
;
;
;
	.PAGE
	.SBTTL	PRINT VARIOUS BINARY TO ASCII FORMATS
;
;
	.MACRO	P.D	Y,X,Z		;GENERAL PROCEDURE
	.NARG NARG
	.EMIT	<MOV R0,-(SP)>		;SAVE GENERAL REGISTER R0
	CNT	=	0		;OFFSET INTO CALL ROUTINE
	.IF EQ NARG-3			;HAVE THREE ARGS BEEN PASSED ?
	.IF IDN Z,BYTE
	.EMIT	<MOVB X,R0>		;HOLD BINARY BYTE VALUE
	.IIF IDN Y,BIN	CNT=2		;OFFSET TWO BYTES
	.IIF IDN Y,HEX	CNT=2		;OFFSET TWO BYTES
	.IIF IDN Y,OCT	CNT=2		;OFFSET TWO BYTES
	.IFF
	.EMIT	<MOV X,R0>		;HOLD BINARY WORD VALUE
	.ENDC
	.ENDC
	.IIF EQ NARG-2 MOV X,R0		;HOLD BINARY WORD VALUE
	.IIF	EQ	LST$$	.LIST
	CALL R$B'Y+CNT
	CALL V$TX			;OUTPUT DATA
	MOV (SP)+,R0			;RESTORE GENREAL REGISTER R0
	.IIF	EQ	LST$$	.NLIST
.ENDM	P.D				;END OF PRINT DATA MACRO
;
;
.MACRO	PRINTA	REG,FORM
	.MCALL	P.D
	.NARG NARG
	.IIF EQ NARG-2	P.D ASC,REG,FORM
	.IIF EQ NARG-1	P.D ASC,REG
	.IIF EQ NARG	P.D ASC
.ENDM	PRINTA
;
.MACRO	PRINTB	REG,FORM
	.MCALL	P.D
	.NARG NARG
	.IIF EQ NARG-2	P.D BIN,REG,FORM
	.IIF EQ NARG-1	P.D BIN,REG
	.IIF EQ NARG	P.D BIN
.ENDM	PRINTB
;
;
.MACRO	PRINTD	REG,FORM
	.MCALL	P.D
	.NARG NARG
	.IIF EQ NARG-2	P.D DEC,REG,FORM
	.IIF EQ NARG-1	P.D DEC,REG
	.IIF EQ NARG	P.D DEC
.ENDM	PRINTD
;
;
.MACRO	PRINTH	REG,FORM
	.MCALL	P.D
	.NARG NARG
	.IIF EQ NARG-2	P.D HEX,REG,FORM
	.IIF EQ NARG-1	P.D HEX,REG
	.IIF EQ NARG	P.D HEX
.ENDM	PRINTH
;
;
.MACRO	PRINTO	REG,FORM
	.MCALL	P.D
	.NARG NARG
	.IIF EQ NARG-2	P.D OCT,REG,FORM
	.IIF EQ NARG-1	P.D OCT,REG
	.IIF EQ NARG	P.D OCT
.ENDM	PRINTO
;
;
.MACRO	PRINTR	REG,FORM
	.MCALL	P.D
	.NARG NARG
	.IIF EQ NARG-2	P.D R50,REG,FORM
	.IIF EQ NARG-1	P.D R50,REG
	.IIF EQ NARG	P.D R50
.ENDM	PRINTR
;
;
.MACRO REPCHAR	CHAR,COUNT
	.EMIT	<CALL	V$TXC		;DUMP REPEATED CHARACTERS>
	.IIF EQ	COUNT&377	.EMIT	<.BYTE 1,CHAR&377>
	.IIF NE	COUNT&377	.EMIT	<.BYTE COUNT&377,CHAR&377>
.ENDM	REPCHAR
;
;
;
.MACRO PTEXT	STRING,?A
	.IIF	EQ	LST$$	.LIST
		CALL	V$TXB
		.WORD	A-.-2
		.ASCII	STRING
A:		.EVEN
	.IIF	EQ	LST$$	.NLIST
.ENDM	PTEXT
;
	.END
