	.TITLE	MG09..	ADDRESS TRANSFER PREPROCESSOR FOR V$TX
	.IDENT	/MG09../
;
	.PAGE
	.SBTTL	STRING ADDRESS WITH ADDRESS FOLLOWING CALL
;
V$TXA::				;THIS PROCEDURE TRANSFERS A BLOCK OD DATA
				;TO THE TERMINAL DISPLAY
;
;		ENTRY CONDITIONS
;		ADDRESS OF DATA FOLLOWS PROCEDURE CALL
;
;		EXIT CONDITIONS
;		NONE
;
	MOV R0,-(SP)		;PROTECT REGISTER R0
	MOV @2(SP),R0		;HOLD ADDRESS OF DATA AREA
	ADD #2,2(SP)		;FUDGE RETURN ADDRESS TO BYPASS DATA ADDRESS
	CALL V$TX		;OUTPUT DATA
	MOV (SP)+,R0		;RESTORE REGISTER R0
	RETURN			;BACK TO CALLING PROGRAM
;
	.END
;
;
;
