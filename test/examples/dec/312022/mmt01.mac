	.TITLE	MMT1..
	.IDENT	/MMT1../
;
MT$EXIT::				;THIS IS THE GENERAL EXIT ROUTINE
;					;THIS ROUTINE RECORDS THE DIRECTIVE
					;STATUS WORD AND CHECKS THE TRANSFER
					;STATUS IN THE I/O STATUS BLOCK
;
;
;	ENTRY CONDITIONS
;	THIS ROUTINE IS ENTERED VAI A JUMP OR BRANCH ORDER
;	AND I/O OPERATION HAS JUST BEEN COMPLETED
;
;	EXIT CONDITIONS
;	STATUS FLAG THEN RETURN TO CALLING PROGRAM
;
	MOV $DSW,MT$DSW	 		;HOLD DSW
	IFERROR 10$
	CMPB	MT$ISB,#IS.SUC		;STATUS=SUCCESS
	BEQ	20$
10$: 	EXITERROR
20$:	EXITSUCCESS
;
;
;
;
;
;
	.END
;
