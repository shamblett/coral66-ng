   'CORAL' P8 DTOR MODULE
 
 
   'COMMON' ('FLOATING''PROCEDURE' DTOR ('VALUE''FLOATING'));
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'FLOATING''PROCEDURE' D TO R ('VALUE''FLOATING' ANGLE);
       'BEGIN'
           'FLOATING' RESULT;
 
           'COMMENT' THIS PROCEDURE CONVERTS DEGREES TO RADIANS;
           RESULT:=ANGLE*0.0174533; (SAME AS ANGLE/180*PI)
           'ANSWER' RESULT;
       'END'OF PROCEDURE D TO R;
   'END';
   'FINISH'
