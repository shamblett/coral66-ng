	.TITLE	MC02.. STRING PROCEDURES FOR CORAL IN MACRO
;
	.IDENT	/MC02../
;
	.PAGE
	.SBTTL	COMPARE PROCEDURE (COMPARE)
;
;
COMPARE::
;
	SAVE R1,R2		;SAVE REGISTERS R1 AND R2
	MOV 2(R5),R0		;CHECK IF ADDRESSES VALID
	CALL R$ADDRESS
	IFERROR	100$		;J IF ERROR ADDRESS
	MOV R0,R1		;1ST STRING
	MOV 4(R5),R0
	CALL R$ADDRESS
	IFERROR	105$		;J IF ERROR ADDRESS
	MOV R0,R2		;2ND STRING
	CALL R$COMPARE		;COMPARE CHARACTER STRINGS
	BR	140$		; BYE BYE
;
100$:	MOV #-1,R0		;LESS THAN STRING
	BR	140$
105$:	MOV #1,R0		;GREATER THAN STRING
140$:
	UNSAVE R1,R2		;RESTORE SAVED REGISTERS
	RETURN			;EXIT BYE BYE
;
;
	.END
;
;
