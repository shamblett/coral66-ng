	.TITLE	ML12..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML12../
;
	.SBTTL	.		ADD ONE STRING TO ANOTHER.
;
L$ADDTO::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	STRING TO APPEND.
;	CD.DST	->	CHARACTER STRING TO BE APPENDED TOO.
;
;	EXIT CONDITIONS
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.SRC,R2
	MOV	CD.DST,R1
	CALL	R$ADDTO
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
