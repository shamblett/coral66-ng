	.TITLE MLC5.. CHARACTER PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/MLC5../
;
	.SBTTL	.		DELETE A CHARACTER WITHIN A STRING.
;
;
L$DELC::	;DELETE A CHARACTER WITHIN A STRING.
;
;	ENTRY CONDITIONS
;
;	CD.SRC	->	STRING ADDRESS
;	CD.POS	=	CHARACTER POSITION TO DELETE
;
;	EXIT CONDITIONS
;
;	ERROREXIT IF INVALID CONDITIONS.
;
	CALL	R$SAVE
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	CALL	R$DELC
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
