	.TITLE	MLC6..	CHARACTER PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/MLC6./
;
	.SBTTL	.		LOCATE POSITION OF CHARACTER IN STRING.
;
L$POSC::
;	ENTRY CONDITIONS
;
;	CD.CHR	=	CHARACTER TO LOCATE.
;	CD.SRC	->	STRING ADDRESS TO LOCATE CHARACTER IN.
;	CD.POS	=	START POSITION TO START SEARCH IN STRING.
;
;	EXIT CONDITIONS
;
;	CD.POS	=	UNCHANGED IF CHARACTER NOT FOUND (EXITERROR).
;	CD.POS	=	CHARACTER POSITION (EXITSUCCESS).
;
	CALL	R$SAVE
	MOV	CD.CHR,R0
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	CALL	R$POSC
	BCS	10$		;IF ERROR THEN BRANCH.
	MOV	R2,CD.POS
10$:	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
