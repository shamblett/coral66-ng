	.TITLE	MLC12.	CHARACTER PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/MLC12./
;
	.SBTTL	.		APPEND A STRING TO A STRING.
;
L$ADDS::	;ADD ONE STRING TO ANOTHER STRING.
;
;	ENTRY CONSITIONS.
;
;	CD.SRC	->	CHARACTER STRING TO ADD.
;	CD.DST	->	CHARACTER STRING TO BE ADDED TO.
;
;	EXIT CONDITIONS.
;
;	ERROREXIT IF INVALID CONDITIONS.
;
	CALL	R$SAVE
	MOV	CD.SRC,R0
	MOV	CD.DST,R4
	CALL	R$ADDS
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
