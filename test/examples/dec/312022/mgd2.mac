	.TITLE	MGD2..	FIXED DATA AREA FOR IO OPERATIONS
	.IDENT	/MGD2../
	.SBTTL	VDU FIXED DATA AREA
;
;
V$LST::				;MESSAGE TABLE
	.WORD V$S01,V$02
	.WORD V$S02,V$03
	.WORD V$S03,V$01
	.WORD V$S04,V$04
	.WORD V$S05,V$05
	.WORD V$S06
V$00::	.WORD V$00			;ADDRESS OF INPUT MESSAGE
	.WORD V$S07,V$06
	.WORD V$S08,V$07
	.WORD V$S09,V$01
	.WORD V$S10,V$01
	.WORD V$S11,V$02
	.WORD 0				;CONTROL LIST TERMINATOR
;
V$01::	.BYTE	2,0,<LF>,<CR>		;CRLF
V$02::	.BYTE	1,0,<CR>,0		;CR
V$03::	.BYTE	1,0,<LF>,0		;LF
V$04::	.BYTE	2,0,ESC,72.		;CURSOR HOME
V$05::	.BYTE	4,0,ESC,72.,ESC,74.	;CLEAR SCREEN
V$06::	.BYTE	2,0,ESC,74.		;CLEAR TO END OF SCREEN
V$07::	.BYTE	2,0,ESC,75.		;CLEAR TO END OF LINE
V$08::	.BYTE	4,0,ESC,89.		;SET CURSOR TO POSITION BELOW
V$09::	.BYTE	0,0			;POSITION
;
	STRING "CR",	V$S01:
	STRING "LF",	V$S02:
	STRING "PRE",	V$S03:
	STRING "REF",	V$S04:
	STRING "CLEARS",V$S05:
	STRING "O",	V$S06:
	STRING "CLEARE",V$S07:
	STRING "CLEARL",V$S08:
	STRING "NL",	V$S09:
	STRING "END",	V$S10:
	STRING "RET",	V$S11:
	STRING "-",	V$S12:
	STRING "@",	V$S13:
	STRING "(",	V$S14:
	STRING ")",	V$S15:
	STRING "I",	V$S16:
	STRING <<LF><CR>"SYNTAX ERROR USING INPUT MODE"<LF><CR>>,V$S17:
	STRING <" ? ">,	V$S18:
	STRING "SETCUR",V$S20:
;
	.END
;
