	.TITLE	MMT5..
	.IDENT	/MMT5../
	.MCALL ALUN$S
;
MT$OPEN::			;THIS ROUTINE OPENS A MAGNETIC TAPE CHANNEL
;
;	ENTRY CONDITIONS
;	NONE
;
;	EXIT CONDITIONS
;	STATUS = SUCCESS OR ERROR
;
	ALUN$S MT$LUN,#"MM,MT$UNIT
	MOV $DSW,MT$DSW		;SAVE DIRECTIVE STATUS WORD
	RETURN			;BACK TO CALLING PROGRAM
;
	.END
;
;
