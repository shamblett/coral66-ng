	.TITLE	MMT2..
	.IDENT	/MMT2../
	.MCALL QIOW$S
;
MT$GET::
;
;	ENTRY CONDITIONS
;	R0 -> STRING ADDRESS
;
;	EXIT CONDITIONS
;	STATUS ONLY
;
	MOV R2,-(SP)		;SAVE R2
	MOV R0,R2		;HOLD ADDRESS OF BUFFER
	ADD #2,R2		;R2-> START ADDRESS OF DATA AREA
;
	QIOW$S	#IO.RLB,MT$LUN,MT$EFN,,#MT$ISB,,<R2,-2(R0)>
	MOV (SP)+,R2		;RESTORE CONTENTS OF REGISTER TWO
	MOV MT$ISB+2,(R0)	;HOLD NUMBER OF CHARACTER READ
	JMP MT$EXIT		;RETURN VIA GENERAL EXIT ROUTINE
;
 
;
;
	.END
;
;
;
