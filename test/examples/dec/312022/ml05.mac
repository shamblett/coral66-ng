	.TITLE	ML05..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML05../
;
	.SBTTL	.		CHARACTER POSITION ROUTINES.
;
L$POS3::	;POSITION ROUTINE, 3 PARAMETERS.
;
;	ENTRY CONDITIONS.
;
;	CD.SRC	->	MASTER STRING
;	CD.DST	->	SEARCH STRING
;	CD.POS	=	START POSITION OF SEARCH.
;
;	EXIT CONDITIONS
;
;	CD.POS	=	POSITION OF FIRST CHARACTER IF MATCH FOUND.(SUCCESS)
;	CD.POS	=	'0' IF NO MATCH FOUND.	(ERROR)
;
	CALL	R$SAVE
	MOV	CD.SRC,R1
	MOV	CD.DST,R2
	MOV	CD.POS,R0
	CALL	R$POS3
	MOV	R0,CD.POS
	CALL	R$UNSAVE
	RETURN
;
;
;
;
L$POS2::	;POSITION ROUTINE, 2 PARAMETERS.
;
;	ENTRY CONDITIONS.
;
;	CD.SRC	->	MASTER STRING
;	CD.DST	->	SEARCH STRING
;
;	EXIT CONDITIONS
;
;	CD.POS	=	POSITION OF FIRST CHARACTER IF MATCH FOUND.(SUCCESS)
;	CD.POS	=	'0' IF NO MATCH FOUND.	(ERROR)
	CALL	R$SAVE
	MOV	CD.SRC,R1
	MOV	CD.DST,R2
	CALL	R$POS2
	MOV	R0,CD.POS
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
