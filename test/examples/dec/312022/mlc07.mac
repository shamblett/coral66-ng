	.TITLE	MLC7..	CHARACTER PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/MLC7../
;
	.SBTTL	.		EXTRACT A CHARACTER FROM A STRING.
;
L$MOVC::	;EXTRACT A CHARACTER FROM A STRING.
;
;	ENTRY CONDITIONS
;
;	CD.SRC	->	STRING ADDRESS
;
;	EXIT CONDITIONS
;
;	CD.CHR	=	CHARACTER IF STATUS EQUALS SUCCESS.
;
	CALL	R$SAVE
	MOV	CD.SRC,R1
	CALL	R$MOVC
	MOV	R0,CD.CHR
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
