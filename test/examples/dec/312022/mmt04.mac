	.TITLE	MMT4..
	.IDENT	/MMT4../
	.MCALL QIOW$S
;
MT$PUT::
;
;	ENTRY CONDITIONS
;	R0 -> STRING ADDRESS
;
;	EXIT CONDITIONS
;	STATUS = SUCCESS IN STRING LOAD SUCCESFULLY
;
	MOV R2,-(SP)		;SAVE R2
	MOV R0,R2		;HOLD ADDRESS OF BUFFER
	ADD #2,R2	 	;R2-> START OF OUTPUT DATA
;
	QIOW$S	#IO.WLB,MT$LUN,MT$EFN,,#MT$ISB,,<R2,@R0>
	MOV (SP)+,R2		;RESTORE R2
	JMP MT$EXIT		;RETURN VIA GENERAL EXIT ROUTINE
;
	.END
;
