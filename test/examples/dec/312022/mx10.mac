	.PAGE
	.SBTTL	.	INPUT STRING
;
;
;
.MACRO	INPUT	?A
	.NARG	NARG
.IF EQ	NARG
	.EMIT	<CALL	V$INPUT		 ;READ STRING ADDRESS IN R0>
.ENDC
;
.IF EQ	NARG-1				;? ONE PARAMETER
					;MUST HAVE PARAMETER SPECIFIED
;
	.EMIT	<CALL	R$SAVE		;SAVE THE REGISTERS>
	.NTYPE	NTYPE,A
	.IIF EQ	NTYPE-27 .EMIT <MOV A,R0	;ADDRESS GIVEN FOR STRING>
	.IIF EQ	NTYPE-67 .EMIT <MOV #A,R0 ;STRING GIVEN CONVERT ADDRESS>
	.IIF EQ	NTYPE-77 .EMIT <MOV A,R0	;LOAD ADDRESS OF STRING INTO R0>
	.IIF EQ	NTYPE&60 .EMIT <MOV A,R0	;HOLD ADDRESS OF OUTPUT STRING>
	.IIF	EQ	LST$$	.LIST
		MOV R0,R1		;HOLD OUTPUT ADDRESS
		CALL R$CLEAR		;CLEAR STRING
		CALL V$INPUT		;READ STRING
		MOV R0,R2		;HOLD INPUT  ADDRESS
		CALL R$ADDTO		;COPY INPUT STRING TO SPECIFIED OUTPUT AREA
		CALL	R$UNSAVE	;RESTORE THE REGISTERS
	.IIF	EQ	LST$$	.NLIST
;
.ENDC
.ENDM	INPUT
;
;

;
;
	.SBTTL	.	INPUT STRING WITH NO ECHO
;
;
;
.MACRO	INPUTNE	?A
	.NARG	NARG
.IF EQ	NARG				;NO PARAMS R0 = ADDRESS
	.EMIT	<CALL	V$INPUT+2	;READ STRING ADDRESS IN R0>
.ENDC
;
.IF EQ	NARG-1				;? ONE PARAMETER
					;MUST HAVE PARAMETER SPECIFIED
;
	.EMIT	<CALL	R$SAVE		;SAVE THE REGISTERS>
	.NTYPE	NTYPE,A
	.IIF EQ	NTYPE-27 .EMIT <MOV A,R0	;ADDRESS GIVEN FOR STRING>
	.IIF EQ	NTYPE-67 .EMIT <MOV #A,R0	;STRING GIVEN CONVERT ADDRESS>
	.IIF EQ	NTYPE-77 .EMIT <MOV A,R0	;LOAD ADDRESS OF STRING INTO R0>
	.IIF EQ	NTYPE&60 .EMIT <MOV A,R0	;HOLD ADDRESS OF OUTPUT STRING>
	.IIF	EQ	LST$$	.LIST
		MOV R0,R1		;HOLD OUTPUT ADDRESS
		CALL R$CLEAR		;CLEAR STRING
		CALL V$INPUT+2		;READ STRING
		MOV R0,R2		;HOLD INPUT  ADDRESS
		CALL R$ADDTO		;COPY INPUT STRING TO SPECIFIED OUTPUT AREA
		CALL	R$UNSAVE	;RESTORE THE REGISTERS.
	.IIF	EQ	LST$$	.NLIST
;
.ENDC
.ENDM	INPUTNE
;
;
;
;
	.END
;
;
;
