	.TITLE	MGD1..	GENERAL VDU DATA AREAS
	.IDENT	/MGD1../
;
;
	.SBTTL	VDU COMMON DATA AREAS
;
;
;		VDU INPUT DATA AREA
;
V$UNIT::	.WORD	0		;ASSUME UNIT ZERO
V$DUNT::	.WORD	0		;DEVICE UNIT NUMBER
V$DDEV::	.WORD	"TT		;STANDARD DEFAULT DEVICE IS 'TT'
V$DEV::		.WORD	"TI		;NORMAL PERIPHERAL TYPE USER TERMINAL
V$STA::		.WORD	0		;STATUS FLAGS FOR THE VDU
V$LUN::		.WORD	1		;DEFAULT VDU LUN
V$EFN::		.WORD	1		;DEFAULT VDU EVENT FLAG NUMBER
V$CNT::		.WORD	VDUSIZE		;MAXIMUM NUMBER OF I/P CHARACTERS
V$FUN::		.WORD			;QIO FUNCTION VALUE
V$ISB::		.BYTE			;ERROR STATUS BYTE
		.BYTE			;TERMINATION CHARACTER BYTE
		.WORD			;NUMBER OF CHARACTERS TRANSFERED
;
	RESERVE	VDUSIZE+2,V$STR:
;
;
;
;
	.END
;
;
