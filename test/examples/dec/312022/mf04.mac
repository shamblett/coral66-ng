	.TITLE	MF04	WRITE A RECORD TO A RECORD TYPE DEVICE
	.IDENT	/MF04../
;
;
;
;
F$PUTR::			;THIS PROCEDURE WRITES A RECORD TO A FILES
				;STRUCTRURED DEVICE
;
;
;		ENTRY CONDITIONS
;	R0 -> ADDRESS OF CHARACTER STRING TO WRITE
;
;		EXIT CONDITIONS
;		STATUS FLAG ONLY
;
;
;
10$:	SAVE R0,R1		;PROTECT REGISTERS
	MOV R0,R1		;HOLD STRING ADDRESS
	MOV F$FDB,R0		;HOLD THE FDB ADDRESS FOR THIS FILE
	MOV @R1,F.NRBD(R0)	;HOLD NUMBER OF BYTES TO BE TRANSFERED
	TST (R1)+		;INC STRING POINTER TO DATA LOAD ADDRESS
	MOV R1,F.NRBD+2(R0)	;HOLD ADDRESS OF OUTPUT DATA
;
	CALL .PUT		;READ THE RECORD
50$:	UNSAVE R0,R1		;RESTORE REGISTERS
	RETURN			;BACK TO CALLING PROGRAM
;
;
	.END
;
;
