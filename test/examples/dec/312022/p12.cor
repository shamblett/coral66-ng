   'CORAL' P12 SQR MODULE
 
 
   'LIBRARY' ('PROCEDURE' MOV ('VALUE''FLOATING','VALUE''FLOATING');
   'PROCEDURE' PLT ('VALUE''FLOATING','VALUE''FLOATING');
   'PROCEDURE' WHERE ('LOCATION''FLOATING','LOCATION''FLOATING','LOCATION''FLOATING'));
   'COMMON' ('PROCEDURE' SQR ('VALUE''FLOATING'));
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'PROCEDURE' SQR ('VALUE''FLOATING' SIZE);
       'BEGIN'
           'FLOATING' X, Y, F, XCENT, YCENT;
 
           'COMMENT' LOCATE CENTER OF CHARACTER;
           WHERE(XCENT,YCENT,F);
           'IF' SIZE>0 
           'THEN'
           'BEGIN'
               X:=-SIZE;   (SET UP BASE SIZE)
               MOV(X*0.707,225);  (BOTTOM LH CORNER)
               PLT(X,90);
               PLT(X,0);
               PLT(X,270);
               PLT(X,180);
           'END';
           MOV(XCENT,YCENT);
       'END'OF PROCEDURE SQR;
   'END';
   'FINISH'
