	.TITLE	MF05	OPEN UP FILE
	.IDENT	/MF05../
;
;
;
;
F$OPEN::			;THIS PROCEDURE OPEN UP A FILE
;
;
;		ENTRY CONDITIONS
;		NONE
;
;		EXIT CONDITIONS
;		STATUS FLAGS ONLY
;
;
10$:	SAVE R0			;PROTECT REGISTER
	MOV F$FDB,R0		;HOLD THE FDB ADDRESS FOR THIS FILE
	CALL .OPEN		;OPEN UP FILE
50$:	UNSAVE R0		;RESTORE REGISTER
	RETURN			;BACK TO CALLING PROGRAM
;
;
	.END
;
;
