	.TITLE	MRC11.	CHARACTER PROCEDURES IN MACRO
;
	.IDENT	/MRC11./
;
	.PAGE
	.SBTTL .	CONVERT UPPER CASE CHARACTERS TO LOWERCASE
;
R$UCLC::			;CONVERT AN UPPERCASE CHARACTER TO LOWERCASE
;
;		ENTRY CONDITIONS
;	R0 =	CHARACTER
;
;		EXIT CONDITIONS
;	R0 = CONVERTED CHARACTER
;
;
	SAVE R1			;PROTECT R1
	MOV R0,R1		;HOLD CHARACTER
	BIC #177600,R1		;STRIP PARITY BIT
	CMP R1,#65.		;IS CHARACTER IN UC RANGE
	BLT	10$		;J IF NOT UC CHARACTER
	CMP R1,#90.		;IS CHARACTER STILL IN UC RANGE
	BGT	10$		;J IF NOT UC CHARACTER
	BIS #40,R1		;CONVERT UC TO LC CHARACTER
	MOV R1,R0		;HOLD CONVERTED CHARACTER
10$:	UNSAVE R1		;RESTORE R1
	RETURN			;EXIT TO CALLING PROGRAM
;
	.END
;
;
