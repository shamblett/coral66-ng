	.TITLE	MRC9..	CHARACTER PROCEDURES IN MACRO
;
	.IDENT	/MRC9../
;
	.PAGE
	.SBTTL	.	COMPARE TWO CHARACTERS MATCH UC AND LC CHARACTERS
;
R$CMPC::				;COMPARE TWO CHARACTERS
;
;		ENTRY CONDITIONS
;
;	R1 -> FIRST CHARACTER
;	R2 ->	SECOND CHARACTER
;
;		EXIT CONDITIONS
;	STATUS SUCCESS IF CHARACTER THE SAME
;
;
	SAVE R0,R1			;PROTECT REGISTERS
	CMPB @R1,@R2			;ARE CHARACTERS THE SAME
	BEQ	10$			;J IF SAME
	MOVB @R1,R0			;HOLD FIRST CHARACTER
	CALL R$LCUC			;CONVERT CHARACTER TO UPPER CASE
	MOV R0,R1			;HOLD FIRST CHARACTER
	MOVB @R2,R0			;HOLD SECOND CHARACTER
	CALL R$LCUC			;CONVERT TO UPPER CASE
	CMP R0,R1			;ARE CHARACTERS NOW THE SAME
	BEQ	10$			;J IF THE SAME
	SETERROR 20$			;INDICATE A MISMATCH
10$:	SETSUCCESS			;INDICATE CHARACTERS THE SAME
20$:	UNSAVE	R0,R1			;RESTORE REGISTERS
	RETURN				;EXIT TO CALLING PROGRAM
;
;
;
;
;
	.END
;
;
