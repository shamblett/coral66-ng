	.SBTTL	.	MACRO TO PRINT A NEWLINE TO VDU
;
;
.MACRO	NEWLINE REPEAT
;
	.IIF	EQ	LST$$	.LIST
		CALL V$TXC		;OUTPUT CR
		.BYTE 1,<CR>
		CALL V$TXC		;OUTPUT REPEAT LF'S
	.IIF	EQ	LST$$	.NLIST
	.IF B REPEAT
	.IFT
	.EMIT	<.BYTE 1>
	.IFF
	.IIF NE REPEAT&377 .EMIT	<.BYTE REPEAT&377>
	.IIF EQ REPEAT&377 .EMIT	<.BYTE 1>
	.ENDC
	.EMIT	<.BYTE <LF>>
;
.ENDM	NEWLINE
;
;
;
	.SBTTL	.	MACRO TO PRINT A NUMBER OF SPACES
;
;
.MACRO	SPACES	COUNT
;
	.EMIT	<CALL V$TXC		;OUTPUT CHARACTER>
	.IF B COUNT
	.IFT
	.EMIT	<.BYTE 1,<SPACE>>
	.IFF
	.IIF NE COUNT&377 .EMIT	<.BYTE COUNT&377,<SPACE>>
	.IIF EQ COUNT&377 .EMIT	<.BYTE 1,<SPACE>>
	.ENDC
.ENDM	SPACES
;
	.END
