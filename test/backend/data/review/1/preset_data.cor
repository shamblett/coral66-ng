'PROGRAM' TEST
'BEGIN'
  'INTEGER' ans;
  'INTEGER' 'ARRAY' MYARR [0:4] 'PRESET' 10, 20, 30, 40, 50;
  'TABLE' MYTAB [1, 3]
  [
    A 'INTEGER' 0
  ] 'PRESET' 100, 200, 300;
  
  ans := 0;
  'IF' MYARR[2] = 30 'THEN'
  'BEGIN'
    'IF' MYTAB[1] = 200 'THEN'
    'BEGIN'
      ans := 1;
    'END'
  'END'
'END'
