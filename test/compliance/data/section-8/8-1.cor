PROGRAM EIGHTONE
COMMENT Procedure parameter passing and evaluation;

BEGIN

    INTEGER count := 0;
    INTEGER count1 := 0;

    PROCEDURE incrementCount
    BEGIN
      count := count + 1;
    END;

    PROCEDURE doCount(PROCEDURE proc)
    BEGIN
      proc;
    END;

    INTEGER PROCEDURE returnCount
    BEGIN
      ANSWER count;
    END;

    PROCEDURE incrementCount1(VALUE INTEGER returnCount)
    BEGIN
       count1 := count1 + returnCount;
    END;

    COMMENT Pass an untyped procedure to a procedure;
    doCount(incrementCount);

    COMMENT Pass a types procedure to a procedure;
    incrementCount1(returnCount);

END
