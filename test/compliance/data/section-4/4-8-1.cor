PROGRAM FOUREIGHTONE
COMMENT Overlay declarations;

BEGIN

  COMMENT Integers, fixed, floating;

  COMMENT integer overlay;
  INTEGER base;
  OVERLAY base WITH INTEGER baseOverlay;

  INTEGER base1;
  OVERLAY base1 WITH INTEGER base1Overlay;

  COMMENT fixed overlay;
  FIXED(13,5) fixedBase;
  OVERLAY fixedBase WITH FIXED(13,5) fixedBaseOverlay;
  OVERLAY fixedBase WITH INTEGER fixedBaseIntegerOverlay;

  COMMENT Floating overlay;
  FLOATING floatBase;
  OVERLAY floatBase WITH FLOATING floatBaseOverlay;

  COMMENT Arrays;

  COMMENT array overlay;
  INTEGER ARRAY arrayBase[1:3];
  OVERLAY arrayBase WITH INTEGER ARRAY arrayBaseOverlay[1:3];

  COMMENT Array overlay with integer;
  OVERLAY arrayBase[2] WITH INTEGER arrayBaseIntegerOverlay;

  COMMENT Tables;

  COMMENT table overlay;
  TABLE baseTable[2,1]
  [ baseTableInteger0 INTEGER 0;
    baseTableInteger1 INTEGER 1;
  ];
  OVERLAY baseTable WITH TABLE baseTableOverlay[2,1]
                           [ baseTableOverlayInteger0 INTEGER 0;
                             baseTableOverlayInteger1 INTEGER 1;
                           ];


  COMMENT Main value setting;

  baseOverlay := 10;
  base1 := 20;
  fixedBase := 8.75;
  floatBase := 2.0;

  COMMENT 0'th element at index 1;
  arrayBase[1] := 10;
  arrayBase[2] := 20;
  arrayBase[3] := 30;

  baseTableOverlayInteger0 := 40;
  baseTableOverlayInteger1 := 50;

END