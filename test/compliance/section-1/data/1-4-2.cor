PROGRAM ONEFOURTWO
COMMENT Out of bounds array access causes sigsev;
BEGIN

   INTEGER ARRAY flags [0 : 4];
   INTEGER ARRAY indices [0 : 4];
   INTEGER iter;
   INTEGER value;

   value := 0;

   flags[0] := 10;
   flags[1] := 20;
   flags[2] := 30;
   flags[3] := 40;

   indices[0] := 1;
   indices[1] := 2;
   indices[2] := 11;
   indices[3] := 23;

   FOR iter := 0 STEP 1 UNTIL 4 DO
   BEGIN
      value := flags[indices[iter]];
   END;
END
