PROGRAM ONEFOURTWO
COMMENT Out of bounds array access causes sigsev;
BEGIN

   INTEGER ARRAY flags, indices[0 : 1];
   INTEGER result;
   INTEGER flags0, flags1;
   INTEGER index0, index1;

   flags[0] := 10;
   flags[1] := 20;
   indices[0] := 0;
   COMMENT Use an out of bounds value that is outside the allocated address space to cause the sigsev;
   indices[1] := 10000000;

   result := -1;
   flags0 := flags[0];
   flags1 := flags[1];
   index0 := indices[0];
   index1 := indices[1];

   result := flags[index1];
END
