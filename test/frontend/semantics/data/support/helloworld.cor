COMMENT
  Obligatory hello world program for Coral 66.
;

COMMENT
   Import only what we need from supported libraries, no need to
   include them explicitly.
;

COMMON ( INTEGER PROCEDURE printfstr(VALUE POINTER, VALUE POINTER);
         PROCEDURE newline;)

BEGIN
  newline;
  printfstr("%s", "Hello World from Coral 66");
END;
