PROGRAM G6

COMMON ()

BEGIN
  INTEGER ARRAY grid [ 1 : 5, 1 : 5 ];
  FLOATING val;
  INTEGER i;

  COMMENT Multidimensional array assignment and scientific notation;
  val := 1.5;
  grid [ 1, 1 ] := 10;
  
  COMMENT FOR loop with multiple elements;
  FOR i := 1, 2, 4, 8 DO
  BEGIN
    grid [ 1, 2 ] := i
  END;

  COMMENT Mixed FOR loop elements;
  FOR i := 1, i * 2 WHILE i < 10 DO
  BEGIN
    val := val + 1.0
  END;

END end of program;
