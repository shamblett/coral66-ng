PROGRAM G8

COMMON (
  LABEL errorPoint;
  INTEGER PROCEDURE computeStatus ( VALUE INTEGER );
  INTEGER ARRAY sharedArr [ 0 : 5 ]
)

BEGIN
  INTEGER val;

  COMMENT Usage of COMMON procedure ;
  val := computeStatus ( 10 );

  IF val <> 0 THEN
    GOTO errorPoint;

  sharedArr [ 0 ] := val;
  GOTO skipError;

  errorPoint:
    val := -1;

  skipError:
    val := 0

END end of program ;
