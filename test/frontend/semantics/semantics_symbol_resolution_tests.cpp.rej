--- test/frontend/semantics/semantics_symbol_resolution_tests.cpp
+++ test/frontend/semantics/semantics_symbol_resolution_tests.cpp
@@ -282,6 +282,34 @@
         REQUIRE(program);
     }
 
+    SECTION("Switch declaration")
+    {
+        auto program = parseProgram("Coral_66_program\n"
+                                    "BEGIN\n"
+                                    "  SWITCH sw := l1, l2, l3;\n"
+                                    "  GOTO sw[1];\n"
+                                    "l1: l2: l3: \n"
+                                    "END\n");
+        REQUIRE(program);
+        
+        SymbolResolutionPass pass(context);
+        pass.run(*program);
+        
+        REQUIRE(DiagnosticCollector::getDiagnostics().empty());
+    }
+
+    SECTION("Table elements declaration")
+    {
+        auto program = parseProgram("Coral_66_program\n"
+                                    "BEGIN\n"
+                                    "  TABLE t[1, 10] [ x INTEGER 0; y FIXED(16,8) 1 ];\n"
+                                    "  x[1] := 0;\n"
+                                    "END\n");
+        REQUIRE(program);
+        SymbolResolutionPass pass(context);
+        pass.run(*program);
+        REQUIRE(DiagnosticCollector::getDiagnostics().empty());
+    }
 }
 
 TEST_CASE("Symbol Resolution - Identifier Resolution", "[Semantics][SymbolResolution]")
