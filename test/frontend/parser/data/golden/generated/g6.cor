PROGRAM G6

EXTERNAL (
  INTEGER PROCEDURE computeStatus ( VALUE INTEGER );
)

LIBRARY ( myMathsLib; MyIOLib; )

ABSOLUTE { INTEGER register \ 1024; )

BEGIN
  INTEGER val;
  INTEGER ARRAY sharedArr [ 0 : 5 ];

  COMMENT Usage of EXTERNAL procedure ;
  val := computeStatus ( 10 );

  IF val <> 0 THEN
    GOTO errorPoint;

  sharedArr [ 0 ] := val;
  GOTO skipError;

  errorPoint:
    val := -1;

  skipError:
    val := 0

END end of program ;
