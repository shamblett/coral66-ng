COMMENT
/*
 * Project: coral66-ng
 * Author : Gemini
 * Date   : 13/08/2026
 */
 ;

COMMENT 
  Standard C Library <stdio.h> / <stdlib.h> bindings for Coral 66
  
  Note: Pointers (FILE*, char*, void*) and sizes (size_t, fpos_t) are represented as POINTER in Coral 66.
;

SEGMENT stdio

  EXTERNAL (
    COMMENT printf family wrappers ;
    INTEGER PROCEDURE printfintp(VALUE POINTER, VALUE INTEGER);
    INTEGER PROCEDURE printfstrp(VALUE POINTER, VALUE POINTER);
    INTEGER PROCEDURE printf2intp(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
    
    COMMENT fprintf family wrappers ;
    INTEGER PROCEDURE fprintfintp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    INTEGER PROCEDURE fprintfstrp(VALUE POINTER, VALUE POINTER, VALUE POINTER);
    
    COMMENT sprintf family wrappers ;
    INTEGER PROCEDURE sprintfintp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    INTEGER PROCEDURE sprintfstrp(VALUE POINTER, VALUE POINTER, VALUE POINTER);
    
    COMMENT scanf family wrappers ;
    INTEGER PROCEDURE scanfintp(VALUE POINTER, LOCATION INTEGER);
    INTEGER PROCEDURE scanfstrp(VALUE POINTER, VALUE POINTER);
    
    COMMENT fscanf family wrappers ;
    INTEGER PROCEDURE fscanfintp(VALUE POINTER, VALUE POINTER, LOCATION INTEGER);
    INTEGER PROCEDURE fscanfstrp(VALUE POINTER, VALUE POINTER, VALUE POINTER);
    
    COMMENT File Access wrappers ;
    POINTER PROCEDURE fopenp(VALUE POINTER, VALUE POINTER);
    INTEGER PROCEDURE fclosep(VALUE POINTER);
    INTEGER PROCEDURE fflushp(VALUE POINTER);
    PROCEDURE setbufp(VALUE POINTER, VALUE POINTER);
    
    COMMENT Direct Input/Output wrappers ;
    INTEGER PROCEDURE freadp(VALUE POINTER, VALUE INTEGER, VALUE INTEGER, VALUE POINTER);
    INTEGER PROCEDURE fwritep(VALUE POINTER, VALUE INTEGER, VALUE INTEGER, VALUE POINTER);
    
    COMMENT Character and String I/O wrappers ;
    INTEGER PROCEDURE fgetcp(VALUE POINTER);
    POINTER PROCEDURE fgetsp(VALUE POINTER, VALUE INTEGER, VALUE POINTER);
    INTEGER PROCEDURE fputcp(VALUE INTEGER, VALUE POINTER);
    INTEGER PROCEDURE fputsp(VALUE POINTER, VALUE POINTER);
    INTEGER PROCEDURE getcharp;
    POINTER PROCEDURE getsp(VALUE POINTER);
    INTEGER PROCEDURE putcharp(VALUE INTEGER);
    INTEGER PROCEDURE putsp(VALUE POINTER);
    INTEGER PROCEDURE ungetcp(VALUE INTEGER, VALUE POINTER);
    
    COMMENT File Positioning wrappers ;
    INTEGER PROCEDURE ftellp(VALUE POINTER);
    INTEGER PROCEDURE fgetposp(VALUE POINTER, VALUE POINTER);
    INTEGER PROCEDURE fseekp(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
    INTEGER PROCEDURE fsetposp(VALUE POINTER, VALUE POINTER);
    PROCEDURE rewindp(VALUE POINTER);
    
    COMMENT File Operations wrappers ;
    INTEGER PROCEDURE removep(VALUE POINTER);
    INTEGER PROCEDURE renamep(VALUE POINTER, VALUE POINTER);
  )

COMMON (
  COMMENT printf family ;
  INTEGER PROCEDURE Printfint(VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE Printfstr(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE Printf2int(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
  
  COMMENT fprintf family ;
  INTEGER PROCEDURE Fprintfint(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE Fprintfstr(VALUE POINTER, VALUE POINTER, VALUE POINTER);
  
  COMMENT sprintf family ;
  INTEGER PROCEDURE Sprintfint(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE Sprintfstr(VALUE POINTER, VALUE POINTER, VALUE POINTER);
  
  COMMENT scanf family ;
  INTEGER PROCEDURE Scanfint(VALUE POINTER, LOCATION INTEGER);
  INTEGER PROCEDURE Scanfstr(VALUE POINTER, VALUE POINTER);
  
  COMMENT fscanf family ;
  INTEGER PROCEDURE Fscanfint(VALUE POINTER, VALUE POINTER, LOCATION INTEGER);
  INTEGER PROCEDURE Fscanfstr(VALUE POINTER, VALUE POINTER, VALUE POINTER);

  COMMENT File Access ;
  POINTER PROCEDURE Fopen(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE Fclose(VALUE POINTER);
  INTEGER PROCEDURE Fflush(VALUE POINTER);
  PROCEDURE Setbuf(VALUE POINTER, VALUE POINTER);

  COMMENT Character and String I/O wrappers ;
  INTEGER PROCEDURE Getchar;

  COMMENT Library convenience  procedures ;
  PROCEDURE Newline;
  PROCEDURE Print(VALUE POINTER);
)

BEGIN
  COMMENT printf family ;
  INTEGER PROCEDURE Printfint(VALUE POINTER fmt, VALUE INTEGER arg);
  BEGIN ANSWER printfintp(fmt, arg); END;

  INTEGER PROCEDURE Printfstr(VALUE POINTER fmt, VALUE POINTER arg);
  BEGIN ANSWER printfstrp(fmt, arg); END;
  
  INTEGER PROCEDURE Printf2int(VALUE POINTER fmt, VALUE INTEGER arg1, VALUE INTEGER arg2);
  BEGIN ANSWER printf2intp(fmt, arg1, arg2); END;

  COMMENT fprintf family ;
  INTEGER PROCEDURE Fprintfint(VALUE POINTER stream, VALUE POINTER fmt, VALUE INTEGER arg);
  BEGIN ANSWER fprintfintp(stream, fmt, arg); END;

  INTEGER PROCEDURE Fprintfstr(VALUE POINTER stream, VALUE POINTER fmt, VALUE POINTER arg);
  BEGIN ANSWER fprintfstrp(stream, fmt, arg); END;
  
  COMMENT sprintf family ;
  INTEGER PROCEDURE Sprintfint(VALUE POINTER str, VALUE POINTER fmt, VALUE INTEGER arg);
  BEGIN ANSWER sprintfintp(str, fmt, arg); END;

  INTEGER PROCEDURE Sprintfstr(VALUE POINTER str, VALUE POINTER fmt, VALUE POINTER arg);
  BEGIN ANSWER sprintfstrp(str, fmt, arg); END;

  COMMENT scanf family ;
  INTEGER PROCEDURE Scanfint(VALUE POINTER fmt, LOCATION INTEGER arg);
  BEGIN ANSWER scanfintp(fmt, arg); END;

  INTEGER PROCEDURE Scanfstr(VALUE POINTER fmt, VALUE POINTER arg);
  BEGIN ANSWER scanfstrp(fmt, arg); END;
  
  COMMENT fscanf family ;
  INTEGER PROCEDURE Fscanfint(VALUE POINTER stream, VALUE POINTER fmt, LOCATION INTEGER arg);
  BEGIN ANSWER fscanfintp(stream, fmt, arg); END;

  INTEGER PROCEDURE Fscanfstr(VALUE POINTER stream, VALUE POINTER fmt, VALUE POINTER arg);
  BEGIN ANSWER fscanfstrp(stream, fmt, arg); END;

  COMMENT File Access ;
  POINTER PROCEDURE Fopen(VALUE POINTER filename, VALUE POINTER mode);
  BEGIN ANSWER fopenp(filename, mode); END;

  INTEGER PROCEDURE Fclose(VALUE POINTER stream);
  BEGIN ANSWER fclosep(stream); END;

  INTEGER PROCEDURE Fflush(VALUE POINTER stream);
  BEGIN ANSWER fflushp(stream); END;

  PROCEDURE Setbuf(VALUE POINTER stream, VALUE POINTER buffer);
  BEGIN setbufp(stream, buffer); END;

   COMMENT Character and String I/O wrappers ;
   INTEGER PROCEDURE Getchar
   BEGIN ANSWER getcharp; END;

  COMMENT Library convenience procedures ;

  PROCEDURE Newline;
     BEGIN
       Printfstr("%s\n", "");
     END;

   PROCEDURE Print(VALUE POINTER string)
      BEGIN
        Printfstr("%s\n", string);

      END;
END
