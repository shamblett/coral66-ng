COMMENT
/*
 * Project: coral66-ng
 * Author : Gemini
 * Date   : 13/08/2026
 */
 ;

COMMENT 
  Standard C Library <stdio.h> / <stdlib.h> bindings for Coral 66
  
  Note: Pointers (FILE*, char*, void*) and sizes (size_t, fpos_t) are represented as POINTER in Coral 66.
;

SEGMENT stdio

  

COMMON (
  COMMENT printf family ;
  INTEGER PROCEDURE printfint(VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE printfstr(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE printf2int(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
  
  COMMENT fprintf family ;
  INTEGER PROCEDURE fprintfint(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE fprintfstr(VALUE POINTER, VALUE POINTER, VALUE POINTER);
  
  COMMENT sprintf family ;
  INTEGER PROCEDURE sprintfint(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE sprintfstr(VALUE POINTER, VALUE POINTER, VALUE POINTER);
  
  COMMENT scanf family ;
  INTEGER PROCEDURE scanfint(VALUE POINTER, LOCATION INTEGER);
  INTEGER PROCEDURE scanfstr(VALUE POINTER, VALUE POINTER);
  
  COMMENT fscanf family ;
  INTEGER PROCEDURE fscanfint(VALUE POINTER, VALUE POINTER, LOCATION INTEGER);
  INTEGER PROCEDURE fscanfstr(VALUE POINTER, VALUE POINTER, VALUE POINTER);

  COMMENT File Access ;
  POINTER PROCEDURE fopen(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE fclose(VALUE POINTER);
  INTEGER PROCEDURE fflush(VALUE POINTER);
  PROCEDURE setbuf(VALUE POINTER, VALUE POINTER);

  COMMENT Direct Input/Output;
  INTEGER PROCEDURE fread(VALUE POINTER, VALUE INTEGER, VALUE INTEGER, VALUE POINTER);
  INTEGER PROCEDURE fwrite(VALUE POINTER, VALUE INTEGER, VALUE INTEGER, VALUE POINTER);

  COMMENT Character and String I/O;
  INTEGER PROCEDURE fgetc(VALUE POINTER);
  POINTER PROCEDURE fgets(VALUE POINTER, VALUE INTEGER, VALUE POINTER);
  INTEGER PROCEDURE fputc(VALUE INTEGER, VALUE POINTER);
  INTEGER PROCEDURE fputs(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE getchar;
  POINTER PROCEDURE gets(VALUE POINTER);
  INTEGER PROCEDURE putchar(VALUE INTEGER);
  INTEGER PROCEDURE puts(VALUE POINTER);
  INTEGER PROCEDURE ungetc(VALUE INTEGER, VALUE POINTER);

  COMMENT File Positioning ;
  INTEGER PROCEDURE ftell(VALUE POINTER);
  INTEGER PROCEDURE fgetpos(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE fseek(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fsetpos(VALUE POINTER, VALUE POINTER);
  PROCEDURE rewind(VALUE POINTER);

  COMMENT File Operations ;
  INTEGER PROCEDURE remove(VALUE POINTER);
  INTEGER PROCEDURE rename(VALUE POINTER, VALUE POINTER);

  COMMENT Library convenience  procedures ;
  PROCEDURE newline;
  PROCEDURE print(VALUE POINTER);

  COMMENT Defines and constants ;
  INTEGER BUFSIZ := 8192;
  INTEGER EOF := -1;
  INTEGER SEEKSET := 0;
  INTEGER SEEKCUR := 1;
  INTEGER SEEKEND := 2;
  INTEGER FOPENMAX := 16;
)

BEGIN
  COMMENT Library convenience procedures ;
  PROCEDURE newline;
     BEGIN
       printfstr("%s\n", "");
     END;

   PROCEDURE print(VALUE POINTER string)
      BEGIN
        printfstr("%s\n", string);
      END;
END
