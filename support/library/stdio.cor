SEGMENT stdio

COMMENT
/*
 * Project: coral66-ng
 * Author : Gemini
 * Date   : 12/08/2026
 */
 ;

COMMENT 
  Standard C Library <stdio.h> / <stdlib.h> bindings for Coral 66
  
  Note: Pointers (FILE*, char*, void*) and sizes (sizet, fpost) 
  are represented as INTEGER in Coral 66. Because of namespace 
  collisions between EXTERNAL and COMMON, the internal external 
  declarations are suffixed with 'p' and mapped via wrapper procedures.
;

EXTERNAL (
  COMMENT File Access ;
  INTEGER PROCEDURE fopenp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fclosep(VALUE INTEGER);
  INTEGER PROCEDURE fflushp(VALUE INTEGER);
  INTEGER PROCEDURE setbufp(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Direct Input/Output ;
  INTEGER PROCEDURE freadp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fwritep(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Character and String I/O ;
  INTEGER PROCEDURE fgetcp(VALUE INTEGER);
  INTEGER PROCEDURE fgetsp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fputcp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fputsp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE getcharp;
  INTEGER PROCEDURE getsp(VALUE INTEGER);
  INTEGER PROCEDURE putcharp(VALUE INTEGER);
  INTEGER PROCEDURE putsp(VALUE INTEGER);
  INTEGER PROCEDURE ungetcp(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT File Positioning ;
  INTEGER PROCEDURE ftellp(VALUE INTEGER);
  INTEGER PROCEDURE fgetposp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fseekp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fsetposp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE rewindp(VALUE INTEGER);
  
  COMMENT File Operations ;
  INTEGER PROCEDURE removep(VALUE INTEGER);
  INTEGER PROCEDURE renamep(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Fixed-Arity Formatted I/O Wrappers ;
  INTEGER PROCEDURE printfintp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE printfstrp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE printf2intp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fprintfintp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fprintfstrp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE sprintfintp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE sprintfstrp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE scanfintp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE scanfstrp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fscanfintp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fscanfstrp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
)

COMMON (
  COMMENT Expose File Access ;
  INTEGER PROCEDURE fopen(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fclose(VALUE INTEGER);
  INTEGER PROCEDURE fflush(VALUE INTEGER);
  INTEGER PROCEDURE setbuf(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Expose Direct Input/Output ;
  INTEGER PROCEDURE fread(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fwrite(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Expose Character and String I/O ;
  INTEGER PROCEDURE fgetc(VALUE INTEGER);
  INTEGER PROCEDURE fgets(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fputc(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fputs(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE getchar;
  INTEGER PROCEDURE gets(VALUE INTEGER);
  INTEGER PROCEDURE putchar(VALUE INTEGER);
  INTEGER PROCEDURE puts(VALUE INTEGER);
  INTEGER PROCEDURE ungetc(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Expose File Positioning ;
  INTEGER PROCEDURE ftell(VALUE INTEGER);
  INTEGER PROCEDURE fgetpos(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fseek(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fsetpos(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE rewind(VALUE INTEGER);
  
  COMMENT Expose File Operations ;
  INTEGER PROCEDURE remove(VALUE INTEGER);
  INTEGER PROCEDURE rename(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Expose Fixed-Arity Formatted I/O Wrappers ;
  INTEGER PROCEDURE printfint(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE printfstr(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE printf2int(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fprintfint(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fprintfstr(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE sprintfint(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE sprintfstr(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE scanfint(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE scanfstr(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fscanfint(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE fscanfstr(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);

  COMMENT Expose library procedures ;

  PROCEDURE newline;
)

BEGIN

  COMMENT Wrappers ;

  INTEGER PROCEDURE fopen(VALUE INTEGER filename, VALUE INTEGER mode);
  BEGIN ANSWER fopenp(filename, mode); END;

  INTEGER PROCEDURE fclose(VALUE INTEGER stream);
  BEGIN ANSWER fclosep(stream); END;

  INTEGER PROCEDURE fflush(VALUE INTEGER stream);
  BEGIN ANSWER fflushp(stream); END;

  INTEGER PROCEDURE setbuf(VALUE INTEGER stream, VALUE INTEGER buffer);
  BEGIN ANSWER setbufp(stream, buffer); END;


  INTEGER PROCEDURE fread(VALUE INTEGER ptr, VALUE INTEGER size, VALUE INTEGER nmemb, VALUE INTEGER stream);
  BEGIN ANSWER freadp(ptr, size, nmemb, stream); END;

  INTEGER PROCEDURE fwrite(VALUE INTEGER ptr, VALUE INTEGER size, VALUE INTEGER nmemb, VALUE INTEGER stream);
  BEGIN ANSWER fwritep(ptr, size, nmemb, stream); END;


  INTEGER PROCEDURE fgetc(VALUE INTEGER stream);
  BEGIN ANSWER fgetcp(stream); END;

  INTEGER PROCEDURE fgets(VALUE INTEGER str, VALUE INTEGER n, VALUE INTEGER stream);
  BEGIN ANSWER fgetsp(str, n, stream); END;

  INTEGER PROCEDURE fputc(VALUE INTEGER c, VALUE INTEGER stream);
  BEGIN ANSWER fputcp(c, stream); END;

  INTEGER PROCEDURE fputs(VALUE INTEGER str, VALUE INTEGER stream);
  BEGIN ANSWER fputsp(str, stream); END;

  INTEGER PROCEDURE getchar;
  BEGIN ANSWER getcharp; END;

  INTEGER PROCEDURE gets(VALUE INTEGER str);
  BEGIN ANSWER getsp(str); END;

  INTEGER PROCEDURE putchar(VALUE INTEGER c);
  BEGIN ANSWER putcharp(c); END;

  INTEGER PROCEDURE puts(VALUE INTEGER str);
  BEGIN ANSWER putsp(str); END;

  INTEGER PROCEDURE ungetc(VALUE INTEGER c, VALUE INTEGER stream);
  BEGIN ANSWER ungetcp(c, stream); END;


  INTEGER PROCEDURE ftell(VALUE INTEGER stream);
  BEGIN ANSWER ftellp(stream); END;

  INTEGER PROCEDURE fgetpos(VALUE INTEGER stream, VALUE INTEGER pos);
  BEGIN ANSWER fgetposp(stream, pos); END;

  INTEGER PROCEDURE fseek(VALUE INTEGER stream, VALUE INTEGER offset, VALUE INTEGER whence);
  BEGIN ANSWER fseekp(stream, offset, whence); END;

  INTEGER PROCEDURE fsetpos(VALUE INTEGER stream, VALUE INTEGER pos);
  BEGIN ANSWER fsetposp(stream, pos); END;

  INTEGER PROCEDURE rewind(VALUE INTEGER stream);
  BEGIN ANSWER rewindp(stream); END;


  INTEGER PROCEDURE remove(VALUE INTEGER filename);
  BEGIN ANSWER removep(filename); END;

  INTEGER PROCEDURE rename(VALUE INTEGER oldfilename, VALUE INTEGER newfilename);
  BEGIN ANSWER renamep(oldfilename, newfilename); END;

  INTEGER PROCEDURE printfint(VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER printfintp(fmt, arg); END;

  INTEGER PROCEDURE printfstr(VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER printfstrp(fmt, arg); END;

  INTEGER PROCEDURE printf2int(VALUE INTEGER fmt, VALUE INTEGER arg1, VALUE INTEGER arg2);
  BEGIN ANSWER printf2intp(fmt, arg1, arg2); END;

  INTEGER PROCEDURE fprintfint(VALUE INTEGER stream, VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER fprintfintp(stream, fmt, arg); END;

  INTEGER PROCEDURE fprintfstr(VALUE INTEGER stream, VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER fprintfstrp(stream, fmt, arg); END;

  INTEGER PROCEDURE sprintfint(VALUE INTEGER str, VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER sprintfintp(str, fmt, arg); END;

  INTEGER PROCEDURE sprintfstr(VALUE INTEGER str, VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER sprintfstrp(str, fmt, arg); END;

  INTEGER PROCEDURE scanfint(VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER scanfintp(fmt, arg); END;

  INTEGER PROCEDURE scanfstr(VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER scanfstrp(fmt, arg); END;

  INTEGER PROCEDURE fscanfint(VALUE INTEGER stream, VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER fscanfintp(stream, fmt, arg); END;

  INTEGER PROCEDURE fscanfstr(VALUE INTEGER stream, VALUE INTEGER fmt, VALUE INTEGER arg);
  BEGIN ANSWER fscanfstrp(stream, fmt, arg); END;

  COMMENT Library procedures ;

  PROCEDURE newline
     BEGIN
       putsp("\n");
     END;
END
