COMMENT
/*
 * Project: coral66-ng
 * Author : Copyright S. Hamblett <steve.hamblett@linux.com>
 * Date   : 25/08/2026
 */
 ;

COMMENT 
  Standard C Library <unistd.h> / <stdlib.h> bindings for Coral 66
  
  Note: Pointers (FILE*, char*, void*) and sizes (size_t, fpos_t) are represented as POINTER in Coral 66.
;

SEGMENT unistd

  EXTERNAL (

      COMMENT process information ;
      POINTER PROCEDURE cuseridp;
      INTEGER PROCEDURE getegidp;
      INTEGER PROCEDURE geteuidp;
      INTEGER PROCEDURE getgidp;
      INTEGER PROCEDURE getpgidp(VALUE INTEGER);
      INTEGER PROCEDURE getpgrpp;
      INTEGER PROCEDURE getpidp;
      INTEGER PROCEDURE getppidp;
      INTEGER PROCEDURE getsidp(VALUE INTEGER);
      INTEGER PROCEDURE getuidp;

      COMMENT process control ;
      PROCEDURE sleepp(VALUE INTEGER);
      PROCEDURE exitp(VALUE INTEGER);

  )

COMMON (

  COMMENT process information ;
  POINTER PROCEDURE Cuserid;
  INTEGER PROCEDURE Getegid;
  INTEGER PROCEDURE Geteuid;
  INTEGER PROCEDURE Getgid;
  INTEGER PROCEDURE Getpgid(VALUE INTEGER);
  INTEGER PROCEDURE Getpgrp;
  INTEGER PROCEDURE Getpid;
  INTEGER PROCEDURE Getppid;
  INTEGER PROCEDURE Getsid(VALUE INTEGER);
  INTEGER PROCEDURE Getuid;

  COMMENT process control ;
  PROCEDURE Sleep(VALUE INTEGER);
  PROCEDURE Exit(VALUE INTEGER);

  COMMENT Defines and constants ;
  INTEGER ROK := 4;
  INTEGER WOK := 2;
  INTEGER XOK := 1;
  INTEGER FOK := 0;

)

BEGIN

   COMMENT Process information ;

   POINTER PROCEDURE Cuserid
   BEGIN ANSWER cuseridp; END;

   INTEGER PROCEDURE Getegid
   BEGIN ANSWER getegidp; END;

   INTEGER PROCEDURE Geteuid
   BEGIN ANSWER geteuidp; END;

   INTEGER PROCEDURE Getgid
   BEGIN ANSWER getgidp; END;

   INTEGER PROCEDURE Getpgid(VALUE INTEGER pid)
   BEGIN ANSWER getpgidp(pid); END;

   INTEGER PROCEDURE Getpgrp
   BEGIN ANSWER getpgrpp; END;

   INTEGER PROCEDURE Getpid
   BEGIN ANSWER getpidp; END;

   INTEGER PROCEDURE Getppid
   BEGIN ANSWER getppidp; END;

   INTEGER PROCEDURE Getsid(VALUE INTEGER pid)
   BEGIN ANSWER getsidp(pid); END;

   INTEGER PROCEDURE Getuid
   BEGIN ANSWER getuidp; END;

   COMMENT Process control ;

   PROCEDURE Sleep(VALUE INTEGER seconds)
   BEGIN sleepp(seconds); END;

   PROCEDURE Exit(VALUE INTEGER exitCode)
   BEGIN exitp(exitCode); END;

END
