 ;

COMMENT 
  Standard C Library <unistd.h> / <stdlib.h> bindings for Coral 66
  
  Note: Pointers (FILE*, char*, void*) and sizes (size_t, fpos_t) are represented as POINTER in Coral 66.
;

SEGMENT unistd

  

COMMON (

  COMMENT process information ;
  POINTER PROCEDURE cuserid;
  INTEGER PROCEDURE getegid;
  INTEGER PROCEDURE geteuid;
  INTEGER PROCEDURE getgid;
  INTEGER PROCEDURE getpgid(VALUE INTEGER);
  INTEGER PROCEDURE getpgrp;
  INTEGER PROCEDURE getpid;
  INTEGER PROCEDURE getppid;
  INTEGER PROCEDURE getsid(VALUE INTEGER);
  INTEGER PROCEDURE getuid;

  COMMENT process control ;
  PROCEDURE sleep(VALUE INTEGER);
  PROCEDURE exit(VALUE INTEGER);

  COMMENT Defines and constants ;
  INTEGER ROK := 4;
  INTEGER WOK := 2;
  INTEGER XOK := 1;
  INTEGER FOK := 0;

)

BEGIN
END
