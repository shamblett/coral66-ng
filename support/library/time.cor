 ;

COMMENT 
  Standard C Library <time.h> for Coral 66

;

SEGMENT time

 

COMMON (
  COMMENT Define the C tm struct as a TABLE of width 14 words and length 1 ;
  COMMENT Call time externals that need this by passing the location of the first element of the table by name. ;
  COMMENT This correctly passes the base pointer to the C-ABI function. ;
  COMMENT Example mktime(tm);
  TABLE tm [14, 1] [
            tmsec INTEGER 0;
            tmmin INTEGER 1;
            tmhour INTEGER 2;
            tmmday INTEGER 3;
            tmmon INTEGER 4;
            tmyear INTEGER 5;
            tmwday INTEGER 6;
            tmyday INTEGER 7;
            tmisdst INTEGER 8;
            tmgmtoffl INTEGER 9;
            tmgmtoffh INTEGER 10;
            tmpad INTEGER 11;
            tmzonel INTEGER 12;
            tmzoneh INTEGER 13
  ];

  FLOATING PROCEDURE difftime(VALUE POINTER, VALUE POINTER);
  POINTER PROCEDURE time(LOCATION INTEGER);
  INTEGER PROCEDURE clock;

  POINTER PROCEDURE asctime(LOCATION INTEGER);
  POINTER PROCEDURE ctime(VALUE POINTER);
  POINTER PROCEDURE strftime(POINTER, VALUE POINTER, POINTER, LOCATION INTEGER);
  POINTER PROCEDURE gmtime(POINTER);
  POINTER PROCEDURE localtime(POINTER);
  POINTER PROCEDURE mktime(LOCATION INTEGER);

  COMMENT Defines and constants ;
  INTEGER CLOCKSPERSEC := 1000000;


)

BEGIN
END
