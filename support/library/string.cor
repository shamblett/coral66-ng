COMMENT
/*
 * Project: coral66-ng
 * Author : Copyright S. Hamblett <steve.hamblett@linux.com>
 * Date   : 14/08/2026
 */
 ;

COMMENT 
  Standard C Library <string.h> bindings for Coral 66
  
  Note: Pointers (char*, void*) and sizes (size_t) are represented as POINTER/INTEGER in Coral 66.
;

SEGMENT string

  EXTERNAL (
    COMMENT String manipulation wrappers ;
    POINTER PROCEDURE strcpyp(VALUE POINTER, VALUE POINTER);
    POINTER PROCEDURE strncpyp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    POINTER PROCEDURE strcatp(VALUE POINTER, VALUE POINTER);
    POINTER PROCEDURE strncatp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    
    COMMENT String examination wrappers ;
    INTEGER PROCEDURE strcmpp(VALUE POINTER, VALUE POINTER);
    INTEGER PROCEDURE strncmpp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    POINTER PROCEDURE strchrp(VALUE POINTER, VALUE INTEGER);
    POINTER PROCEDURE strrchrp(VALUE POINTER, VALUE INTEGER);
    POINTER PROCEDURE strstrp(VALUE POINTER, VALUE POINTER);
    INTEGER PROCEDURE strlenp(VALUE POINTER);
    
    COMMENT Memory manipulation wrappers ;
    POINTER PROCEDURE memcpyp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    POINTER PROCEDURE memmovep(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    INTEGER PROCEDURE memcmpp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
    POINTER PROCEDURE memchrp(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
    POINTER PROCEDURE memsetp(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
  )

COMMON (
  COMMENT String manipulation ;
  POINTER PROCEDURE Strcpy(VALUE POINTER, VALUE POINTER);
  POINTER PROCEDURE Strncpy(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE Strcat(VALUE POINTER, VALUE POINTER);
  POINTER PROCEDURE Strncat(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  
  COMMENT String examination ;
  INTEGER PROCEDURE Strcmp(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE Strncmp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE Strchr(VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE Strrchr(VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE Strstr(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE Strlen(VALUE POINTER);
  
  COMMENT Memory manipulation ;
  POINTER PROCEDURE Memcpy(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE Memmove(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE Memcmp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE Memchr(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
  POINTER PROCEDURE Memset(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
)

BEGIN
  COMMENT String manipulation ;
  POINTER PROCEDURE Strcpy(VALUE POINTER dest, VALUE POINTER src);
  BEGIN ANSWER strcpyp(dest, src); END;

  POINTER PROCEDURE Strncpy(VALUE POINTER dest, VALUE POINTER src, VALUE INTEGER n);
  BEGIN ANSWER strncpyp(dest, src, n); END;

  POINTER PROCEDURE Strcat(VALUE POINTER dest, VALUE POINTER src);
  BEGIN ANSWER strcatp(dest, src); END;

  POINTER PROCEDURE Strncat(VALUE POINTER dest, VALUE POINTER src, VALUE INTEGER n);
  BEGIN ANSWER strncatp(dest, src, n); END;

  COMMENT String examination ;
  INTEGER PROCEDURE Strcmp(VALUE POINTER str1, VALUE POINTER str2);
  BEGIN ANSWER strcmpp(str1, str2); END;

  INTEGER PROCEDURE Strncmp(VALUE POINTER str1, VALUE POINTER str2, VALUE INTEGER n);
  BEGIN ANSWER strncmpp(str1, str2, n); END;

  POINTER PROCEDURE Strchr(VALUE POINTER str, VALUE INTEGER c);
  BEGIN ANSWER strchrp(str, c); END;

  POINTER PROCEDURE Strrchr(VALUE POINTER str, VALUE INTEGER c);
  BEGIN ANSWER strrchrp(str, c); END;

  POINTER PROCEDURE Strstr(VALUE POINTER haystack, VALUE POINTER needle);
  BEGIN ANSWER strstrp(haystack, needle); END;

  INTEGER PROCEDURE Strlen(VALUE POINTER str);
  BEGIN ANSWER strlenp(str); END;

  COMMENT Memory manipulation ;
  POINTER PROCEDURE Memcpy(VALUE POINTER dest, VALUE POINTER src, VALUE INTEGER n);
  BEGIN ANSWER memcpyp(dest, src, n); END;

  POINTER PROCEDURE Memmove(VALUE POINTER dest, VALUE POINTER src, VALUE INTEGER n);
  BEGIN ANSWER memmovep(dest, src, n); END;

  INTEGER PROCEDURE Memcmp(VALUE POINTER ptr1, VALUE POINTER ptr2, VALUE INTEGER n);
  BEGIN ANSWER memcmpp(ptr1, ptr2, n); END;

  POINTER PROCEDURE Memchr(VALUE POINTER ptr, VALUE INTEGER ch, VALUE INTEGER n);
  BEGIN ANSWER memchrp(ptr, ch, n); END;

  POINTER PROCEDURE Memset(VALUE POINTER ptr, VALUE INTEGER value, VALUE INTEGER num);
  BEGIN ANSWER memsetp(ptr, value, num); END;
END
