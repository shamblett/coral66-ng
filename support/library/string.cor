COMMENT
/*
 * Project: coral66-ng
 * Author : Copyright S. Hamblett <steve.hamblett@linux.com>
 * Date   : 14/08/2026
 */
 ;

COMMENT 
  Standard C Library <string.h> bindings for Coral 66
  
  Note: Pointers (char*, void*) and sizes (size_t) are represented as POINTER/INTEGER in Coral 66.
;

SEGMENT string

  

COMMON (
  COMMENT String manipulation ;
  POINTER PROCEDURE strcpy(VALUE POINTER, VALUE POINTER);
  POINTER PROCEDURE strncpy(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE strcat(VALUE POINTER, VALUE POINTER);
  POINTER PROCEDURE strncat(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  
  COMMENT String examination ;
  INTEGER PROCEDURE strcmp(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE strncmp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE strchr(VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE strrchr(VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE strstr(VALUE POINTER, VALUE POINTER);
  INTEGER PROCEDURE strlen(VALUE POINTER);
  
  COMMENT Memory manipulation ;
  POINTER PROCEDURE memcpy(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE memmove(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  INTEGER PROCEDURE memcmp(VALUE POINTER, VALUE POINTER, VALUE INTEGER);
  POINTER PROCEDURE memchr(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
  POINTER PROCEDURE memset(VALUE POINTER, VALUE INTEGER, VALUE INTEGER);
)

BEGIN
END
