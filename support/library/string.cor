SEGMENT string

COMMENT
/*
 * Project: coral66-ng
 * Author : Copyright S. Hamblett <steve.hamblett@linux.com>
 * Date   : 12/08/2026
 */
 ;

COMMENT 
  Standard C Library <string.h> bindings for Coral 66
  
  Note: Pointers (void*, char*) and sizes (size_t) are represented 
  as INTEGER in Coral 66. Because of namespace collisions between 
  EXTERNAL and COMMON, the internal external declarations are 
  suffixed with 'ext' and mapped via wrapper procedures.
;

EXTERNAL (
  COMMENT Memory Manipulation Functions ;
  INTEGER PROCEDURE memcpyp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memmovep(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memcmpp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memchrp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memsetp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);

  COMMENT String Manipulation Functions ;
  INTEGER PROCEDURE strcpyp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strncpyp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strcatp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strncatp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);

  COMMENT String Examination Functions ;
  INTEGER PROCEDURE strcmpp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strncmpp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strchrp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strrchrp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strspnp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strcspnp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strpbrkp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strstrp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strlenp(VALUE INTEGER);
  
  COMMENT String Tokenization ;
  INTEGER PROCEDURE strtokp(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Error Functions ;
  INTEGER PROCEDURE strerrorp(VALUE INTEGER);
)

COMMON (
  COMMENT Expose Memory Manipulation Functions ;
  INTEGER PROCEDURE memcpy(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memmove(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memcmp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memchr(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE memset(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);

  COMMENT Expose String Manipulation Functions ;
  INTEGER PROCEDURE strcpy(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strncpy(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strcat(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strncat(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);

  COMMENT Expose String Examination Functions ;
  INTEGER PROCEDURE strcmp(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strncmp(VALUE INTEGER, VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strchr(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strrchr(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strspn(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strcspn(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strpbrk(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strstr(VALUE INTEGER, VALUE INTEGER);
  INTEGER PROCEDURE strlen(VALUE INTEGER);
  
  COMMENT Expose String Tokenization ;
  INTEGER PROCEDURE strtok(VALUE INTEGER, VALUE INTEGER);
  
  COMMENT Expose Error Functions ;
  INTEGER PROCEDURE strerror(VALUE INTEGER);
)
BEGIN
  INTEGER PROCEDURE memcpy(VALUE INTEGER dest, VALUE INTEGER src, VALUE INTEGER n);
  BEGIN ANSWER memcpyp(dest, src, n); END;

  INTEGER PROCEDURE memmove(VALUE INTEGER dest, VALUE INTEGER src, VALUE INTEGER n);
  BEGIN ANSWER memmovep(dest, src, n); END;

  INTEGER PROCEDURE memcmp(VALUE INTEGER s1, VALUE INTEGER s2, VALUE INTEGER n);
  BEGIN ANSWER memcmpp(s1, s2, n); END;

  INTEGER PROCEDURE memchr(VALUE INTEGER s, VALUE INTEGER c, VALUE INTEGER n);
  BEGIN ANSWER memchrp(s, c, n); END;

  INTEGER PROCEDURE memset(VALUE INTEGER s, VALUE INTEGER c, VALUE INTEGER n);
  BEGIN ANSWER memsetp(s, c, n); END;


  INTEGER PROCEDURE strcpy(VALUE INTEGER dest, VALUE INTEGER src);
  BEGIN ANSWER strcpyp(dest, src); END;

  INTEGER PROCEDURE strncpy(VALUE INTEGER dest, VALUE INTEGER src, VALUE INTEGER n);
  BEGIN ANSWER strncpyp(dest, src, n); END;

  INTEGER PROCEDURE strcat(VALUE INTEGER dest, VALUE INTEGER src);
  BEGIN ANSWER strcatp(dest, src); END;

  INTEGER PROCEDURE strncat(VALUE INTEGER dest, VALUE INTEGER src, VALUE INTEGER n);
  BEGIN ANSWER strncatp(dest, src, n); END;


  INTEGER PROCEDURE strcmp(VALUE INTEGER s1, VALUE INTEGER s2);
  BEGIN ANSWER strcmpp(s1, s2); END;

  INTEGER PROCEDURE strncmp(VALUE INTEGER s1, VALUE INTEGER s2, VALUE INTEGER n);
  BEGIN ANSWER strncmpp(s1, s2, n); END;

  INTEGER PROCEDURE strchr(VALUE INTEGER s, VALUE INTEGER c);
  BEGIN ANSWER strchrp(s, c); END;

  INTEGER PROCEDURE strrchr(VALUE INTEGER s, VALUE INTEGER c);
  BEGIN ANSWER strrchrp(s, c); END;

  INTEGER PROCEDURE strspn(VALUE INTEGER s, VALUE INTEGER accept);
  BEGIN ANSWER strspnp(s, accept); END;

  INTEGER PROCEDURE strcspn(VALUE INTEGER s, VALUE INTEGER reject);
  BEGIN ANSWER strcspnp(s, reject); END;

  INTEGER PROCEDURE strpbrk(VALUE INTEGER s, VALUE INTEGER accept);
  BEGIN ANSWER strpbrkp(s, accept); END;

  INTEGER PROCEDURE strstr(VALUE INTEGER haystack, VALUE INTEGER needle);
  BEGIN ANSWER strstrp(haystack, needle); END;

  INTEGER PROCEDURE strlen(VALUE INTEGER s);
  BEGIN ANSWER strlenp(s); END;


  INTEGER PROCEDURE strtok(VALUE INTEGER s, VALUE INTEGER delim);
  BEGIN ANSWER strtokp(s, delim); END;


  INTEGER PROCEDURE strerror(VALUE INTEGER errnum);
  BEGIN ANSWER strerrorp(errnum); END;

END
