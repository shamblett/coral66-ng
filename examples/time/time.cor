PROGRAM Time

COMMENT
/*
 * Project: coral66-ng
 * Author : Copyright S. Hamblett <steve.hamblett@linux.com>
 * Date   : 24/08/2026
 */
 ;

COMMENT
  Simple time manipulation example
;



LIBRARY (stdio, time, unistd)

BEGIN

    INTEGER timeval;
    POINTER timestring;

    COMMENT Fill in the exported tm table for a specific time ;
    COMMENT Example: 1st Jan 2024, 12:40:30 ;
    COMMENT This gives Unix time of 1704112830 ;
    
    tmsec[0] := 30;
    tmmin[0] := 40;
    tmhour[0] := 12;
    tmmday[0] := 1;
    tmmon[0] := 0;    COMMENT Jan is 0 ;
    tmyear[0] := 124; COMMENT Years since 1900 (2024 - 1900) ;
    tmwday[0] := 0;   COMMENT ignored by mktime, it calculates this ;
    tmyday[0] := 0;   COMMENT ignored by mktime, it calculates this ;
    tmisdst[0] := -1; COMMENT -1 means info not available ;
    
    COMMENT C ABI Padding and remaining 64-bit fields must be zeroed ;
    tmpad[0] := 0;
    tmgmtoffl[0] := 0;
    tmgmtoffh[0] := 0;
    tmzonel[0] := 0;
    tmzoneh[0] := 0;

    newline;
    print("Time library examples");
    newline;

    COMMENT Call mktime, passing the location of the first element of the table. ;
    COMMENT This correctly passes the base pointer to the C-ABI function. ;
    timeval := mktime(tm);
    printfint("Timeval is : %d", timeval);
    newline;
    IF timeval = 1704112830 THEN
      BEGIN
         print("This is correct");
      END
    ELSE
      BEGIN
        printfint("Oops - timeval is incorrect : %d - exiting", timeval);
        newline;
        exit(-1)
      END;

    newline;


END