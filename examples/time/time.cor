PROGRAM Time

COMMENT
/*
 * Project: coral66-ng
 * Author : Copyright S. Hamblett <steve.hamblett@linux.com>
 * Date   : 24/08/2026
 */
 ;

COMMENT
  Simple time manipulation example
;



LIBRARY (stdio, time, string)

BEGIN

    INTEGER timeval;
    POINTER timestring;

    COMMENT Define the tm struct as a TABLE of width 14 words and length 1 ;
    TABLE tm1 [14, 1] [
            tmsec INTEGER 0;
            tmmin INTEGER 1;
            tmhour INTEGER 2;
            tmmday INTEGER 3;
            tmmon INTEGER 4;
            tmyear INTEGER 5;
            tmwday INTEGER 6;
            tmyday INTEGER 7;
            tmisdst INTEGER 8;
            tmpad INTEGER 9;
            tmgmtoffl INTEGER 10;
            tmgmtoffh INTEGER 11;
            tmzonel INTEGER 12;
            tmzoneh INTEGER 13
    ];

    COMMENT Fill in the struct for a specific time ;
    COMMENT Example: 1st Jan 2024, 12:00:00 ;
    
    tmsec[0] := 0;    
    tmmin[0] := 0;    
    tmhour[0] := 12;   
    tmmday[0] := 1;    
    tmmon[0] := 0;    COMMENT Jan is 0 ;
    tmyear[0] := 124; COMMENT Years since 1900 (2024 - 1900) ;
    tmwday[0] := 0;   COMMENT ignored by mktime, it calculates this ;
    tmyday[0] := 0;   COMMENT ignored by mktime, it calculates this ;
    tmisdst[0] := -1; COMMENT -1 means info not available ;
    
    COMMENT C ABI Padding and remaining 64-bit fields must be zeroed ;
    tmpad[0] := 0;     
    tmgmtoffl[0] := 0; 
    tmgmtoffh[0] := 0; 
    tmzonel[0] := 0;   
    tmzoneh[0] := 0;   
    
    COMMENT Call mktime, passing the location of the first element of the table. ;
    COMMENT This correctly passes the base pointer to the C-ABI function. ;
    timeval := Mktime(tmsec[0]);

    COMMENT Print the time;
    timestring := Asctime(timeval);
    Newline;
    Print("Simple time example");
    Newline;
    timestring := Strcat("The time is :- ", timestring);
    Printfstr("%s", timestring);
    Newline;
END