'PROGRAM' Sieve
'COMMENT' -----------------------------------------------------------------
 -
 -  Filename:
 -
 -     sieve.cor
 -
 -  Description:
 -   
 -     The Sieve of Eratosthenes benchmark, from Byte Magazine early 1980s,
 -     when a PC would do well to run this in 10 seconds. This version
 -     really does count prime numbers but omits the numbers 1, 3 and all 
 -     even numbers. The expected count is 1899.   
 -
 -  Revision: 
 -
 -     $Id: $
 -
 ---------------------------------------------------------------------------;

'LIBRARY' ( stdio, time)

'DEFINE' SIZE "8190";
'DEFINE' EXPECTED "1899";

'DEFINE' CLOCKSPERSEC "(1000000)";

'BEGIN'
   'INTEGER' ans;
   'INTEGER' startTime, stopTime;

   'COMMENT' ---------
             - sieve -
             ---------;

   'ARRAY' Flags [0 : SIZE];

   'INTEGER''PROCEDURE' sieve;
   'BEGIN'
      'INTEGER' iter;
      'INTEGER' count;
   
      'FOR' iter := 1 'STEP' 1 'UNTIL' 10 'DO'
      'BEGIN'
         'INTEGER' i, prime, k;
   
         count := 0;
   
         'FOR' i := 0 'STEP' 1 'UNTIL' SIZE 'DO'
            Flags [i] := 1;
   
         'FOR' i := 0 'STEP' 1 'UNTIL' SIZE 'DO'
         'BEGIN'
            'IF' Flags [i] <> 0 'THEN'
            'BEGIN'
               prime := i + i + 3;
               k := i + prime;
               'FOR' i := i 'WHILE' k <= SIZE 'DO'
               'BEGIN'
                   Flags [k] := 0;
                   k := k + prime;
               'END';
   
               count := count + 1
            'END'
         'END'
      'END';
   
      'ANSWER' count
   'END' sieve;
   
   Newline;
   Print("Sieve of Eratosthenes");
   Newline;
   
   startTime := Clock;
   ans := sieve;
   stopTime := Clock;
   
   'IF' ans <> EXPECTED 'THEN'
      'BEGIN'
         Print("Result is wrong - Failed");
         Newline;
         'GOTO' FailExit;
       'END';

   Printfint("The limit is %d", SIZE);
   Newline;
   Printfint("The Answer is %d, this is correct", ans);
   Newline;
   Printfint("Time taken = %d millisecond(s)", 1000 * (stopTime - startTime) / CLOCKSPERSEC);
   Newline;

FailExit:
'END'

