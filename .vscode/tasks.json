{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Frontend Tests (Debug)",
            "type": "shell",
            "command": "bazel",
            "args": [
                "build",
                "//test/frontend:frontend",
                "--compilation_mode=dbg",
                "--strip=never"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Main Tests (Debug)",
            "type": "shell",
            "command": "bazel",
            "args": [
                "build",
                "//test/main:main",
                "--compilation_mode=dbg",
                "--strip=never"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}