{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Frontend Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bazel-bin/test/frontend/frontend",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Frontend Tests (Debug)",
            "sourceFileMap": {
                "/proc/self/cwd": "${workspaceFolder}"
            }
        },
