# Enable Bzlmod for every Bazel command
common --enable_bzlmod

# C++ standard
build --cxxopt="-std=c++23"

# Write to ccache cache
build --sandbox_writable_path=/home/steve/.cache/ccache

# Colour
build --color=yes
query --color=yes
test --color=yes

# No fission for builds
build --fission=no
build --features=-per_object_debug_info
