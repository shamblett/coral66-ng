	.TITLE	MF03	CLOSE DOWN FILE
	.IDENT	/MF03../
;
;
;
;
F$SHUT::			;THIS PROCEDURE CLOSES DOWN SHUTS A FILE
;
;
;		ENTRY CONDITIONS
;		NONE
;
;		EXIT CONDITIONS
;		STATUS FLAGS ONLY
;
;
10$:	SAVE R0			;PROTECT REGISTER
	MOV F$FDB,R0		;HOLD THE FDB ADDRESS FOR THIS FILE
	CALL .CLOSE		;CLOSE DOWN FILE
50$:	UNSAVE R0		;RESTORE REGISTER
	RETURN			;BACK TO CALLING PROGRAM
;
;
	.END
;
;
