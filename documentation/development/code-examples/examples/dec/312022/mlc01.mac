	.TITLE	MLC1..	LABEL CHARACTER PROCEDURES USING COMMON DICTIONARY.
;
	.IDENT	/MLC1../
;
	.SBTTL	.	CHARACTER/STRING MANIPULATION ROUTINES USING CD.DIC.
;
;
L$GETC::	;EXTRACT A CHARACTER FROM A STRING.
;
;	ENTRY CONDITIONS
;
;	CD.SRC	->	STRING TO PROCESS.
;	CD.POS	=	CHARACTER POSITION TO EXTRACT.
;
;	EXIT CONDITIONS
;
;	CD.CHR	=	EXTRACTED CHARACTER.
;
;	EXITERROR IF INVALID CONDITIONS.
;
	CALL	R$SAVE		;SAVE THE REGISTERS.
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	CALL	R$GETC
	IFERROR	10$
	MOV	R0,CD.CHR
10$:	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
