	.TITLE	MRC3.. CHARACTER PROCEDURES IN MACRO
;
	.IDENT	/MRC3../
;
	.PAGE
	.SBTTL	.		APPEND A CHARACTER TO A STRING
;
R$ADDC::			;ADD A CHARACTER TO A STRING
;
;			ENTRY CONDITIONS
;
;		R0 =  CHARACTER TO ADD TO STRING
;		R4 -> CHARACTER STRING
;
;			EXIT CONDITIONS
;
;		ERROREXIT IF INVAILD CONDITIONS
;
	CMP -2(R4),@R4		;IS STRING FULL OR WRITE PROTECTED
	BLE	10$		;J IF STRING FULL
;
	SAVE R5			;SAVE R5
	MOV R4,R5		;HOLD STRING ADDRESS
	CMPB (R5)+,(R5)+	;OFFSET CONSTANT TO CHARACTERS
	ADD @R4,R5		;R5 -> ACTUAL ADDRESS OF NEXT CHARACTER
	MOVB R0,@R5		;LOAD IN NEXT CHARACTER
	INC @R4			;INCREMENT CHARACTER COUNT FOR STRING
;
	UNSAVE R5		;RESTORE R5
	EXITSUCCESS		;EXIT
;
10$:	EXITERROR		;RETURN TO CALLING PROGRAM
;
;
	.END
;
;
