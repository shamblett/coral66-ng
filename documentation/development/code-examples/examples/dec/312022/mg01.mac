	.TITLE	MG01.. GENERAL PROCEDURES IN MACRO
;
	.IDENT	/MG01../
;
;
	.PAGE
	.SBTTL GENERAL PURPOSE REGISTER UTILITY SUBROUTINES R$ GROUP
	.SBTTL	.	ADDRESS CHECKING VALIDATION ROUTINE
;
;
;
;
R$ADDRESS::
		;CHECK ADDRESS (R0) LEGAL
	TST R0			;DOES ADDRESS = ZERO
	BEQ	10$		;J IF YES
	CMP #-1,R0		;IS ADDRESS -1 ?
	BEQ	10$		;J IF ADDRESS -1
	BIT #1,R0		;CHECK IF ADDRESS ODD
	BNE	10$		;J IF ODD ADDRESS
	EXITSUCCESS		;J AS STATUS IS SUCCESS
10$:	EXITERROR		;J STATUS FAILED
;
;
	.END
;
;
