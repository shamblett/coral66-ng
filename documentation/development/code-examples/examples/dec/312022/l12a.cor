   'CORAL' L12A
   'LIBRARY' (
 
   'COMMENT' BASIC COMPATABLE PROCEDURES;
 
 
   'PROCEDURE' WBLOCK('VALUE''BYTE','LOCATION''INTEGER','VALUE''INTEGER','LOCATION''INTEGER','VALUE''INTEGER',
   'LABEL'));
   'COMMON' ('INTEGER''PROCEDURE' BLOCKOUT ('VALUE''BYTE','VALUE''INTEGER'));
 
   'COMMENT' GENERAL CORAL DEFINITIONS;
   'INCLUDE' "[200,25]GENDEF.COR"
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' BLOCKOUT('VALUE''BYTE' FILE;
       'VALUE''INTEGER'STRING);
       'BEGIN'
           'INTEGER' DUMMY, ADDRESS;
           ADDRESS:= STRING+2;
           WBLOCK(FILE,ADDRESS,512,DUMMY,0,ERRL);
           'ANSWER' SUCCESS;
 ERRL:     'ANSWER' ERROR;
       'END';
   'END';
   'FINISH'
