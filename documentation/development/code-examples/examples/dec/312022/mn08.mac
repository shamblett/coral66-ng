	.TITLE	MN08..	NODE MANIPULATION ROUTINES
	.IDENT	/MN08../
;
	.PAGE
;
;
;
N$UNPROTECT::			;REMOVE PROTECTION BIT FROM NODE
;
;		ENTRY CONDITIONS
;	R1 =	MARKERS
;
;		EXIT CONDITIONS
;	R0 ->	ACCESS ADDRESS  IF STATUS = SUCCESS
;
	CALL N$SEEK		;LOCATE NODE
	IFERROR 10$
	TST -2(R0)		;IS THIS THE LAST NODE
	BEQ	10$		;J IF LAST NODE
	BIC #100000,-2(R0)	;MARK NODE UNPROTECT
	EXITSUCCESS
;
10$:	EXITERROR
;
;

N$PROTECT::			;MARK NODE NON DELETABLE
;
;		ENTRY CONDITIONS
;	R1 =	MARKERS
;
;		EXIT CONDITIONS
;	R0 ->	ACCESS ADDRESS IF STATUS = SUCCESS
;
	CALL N$SEEK		;LOCATE NODE
	IFERROR 10$		;EXIT IF NODE NOT FOUND
	TST -2(R0)		;IS THIS THE LAST NODE
	BEQ	10$		;J IF LAST NODE
	BIS #100000,-2(R0)	;MARK NODE PROTECTED
	EXITSUCCESS
;
10$:	EXITERROR
;
;
;
;
;
	.END
;
;
;
