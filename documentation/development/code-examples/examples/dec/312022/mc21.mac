	.TITLE	MC21.. STRING PROCEDURES FOR CORAL IN MACRO
;
	.IDENT /MC21../
;
	.PAGE
	.SBTTL CLEAR OUT CHARACTER STRING (CLEAR) PROCEDURE
;
CLEAR::
;
	MOV 2(R5),R0			;HOLD STRING ADDRESS
	CALL R$ADDRESS			;CHECK IF ADDRESS VALID
	IFERROR	140$			;J IF INVALID ADDRESS
;
	CALL R$CLEAR			;CLEAR STRING
;
;	PROGRAM EXIT
140$:
	RETURN				;RETURN TO CALLING PROGRAM
;
;
;
	.END
;
;
