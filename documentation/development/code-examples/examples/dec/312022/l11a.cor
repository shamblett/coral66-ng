   'CORAL' L11A
   'LIBRARY' (
 
   'COMMENT' BASIC COMPATABLE PROCEDURES;
 
 
   'PROCEDURE' READREC('VALUE''BYTE','LOCATION''INTEGER','VALUE''INTEGER','LOCATION''INTEGER','LABEL',
   'LABEL'));
   'COMMON' ('INTEGER''PROCEDURE' LFILEIN ('VALUE''BYTE','VALUE''INTEGER'));
 
   'COMMENT' GENERAL CORAL DEFINITIONS;
   'INCLUDE' "[200,25]GENDEF.COR"
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' LFILEIN ('VALUE''BYTE' FILE;
       'VALUE''INTEGER' STRING);
       'BEGIN'
           'INTEGER' ADDRESS,LENGTH,SIZE;
           ADDRESS:=STRING+2;  (HOLD ADDRESS OF DATA AREA)
           SIZE:=[STRING-2];   (HOLD MAX SIZE OF BUFFER)
           READREC(FILE,ADDRESS,SIZE,LENGTH,ERRL,EOFL);
           [STRING]:=LENGTH;   (LOAD NUMBER OF CHARACTER READ)
           'ANSWER' SUCCESS;  (SUCCESS CODE)
 EOFL:     'ANSWER' EOF; (EOF CODE)
 ERRL:     'ANSWER'ERROR;  (ERROR CODE)
       'END';
   'END';
   'FINISH'
