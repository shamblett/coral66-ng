	.TITLE	MLC4..	CHARACTER PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/MLC4../
;
	.SBTTL	.		INSERT CHARACTER AFTER NAMED POSITION.
;
L$INSC::	;INSERT A CHARACTER IN A STRING.
;
;	ENTRY CONDITIONS.
;
;	CD.CHR	=	CHARACTER TO INSERT
;	CD.SRC	->	STRING ADDRESS.
;	CD.POS	=	CHARACTER POSITION.
;
;	EXIT CONDITIONS.
;
;	ERROREXIT IF INVALID CONDITIONS.
;
	CALL	R$SAVE
	MOV	CD.CHR,R0
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	CALL	R$INSC
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
