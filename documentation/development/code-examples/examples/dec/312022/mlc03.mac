	.TITLE	MLC3..	CHARACTER PROCEDURES USING COMMON DICTIONARY.
;
	.IDENT	/MLC3../
;
	.SBTTL	.		APPEND A CHAR TO STRING USING LABELS.
;
L$ADDC::	;ADD A CHARACTER TO A STRING.
;
;	ENTRY CONDITIONS
;
;	CD.CHR	=	CHARACTER TO ADD TO STRING.
;	CD.SRC	->	CHARACTER STRING.
;
;	EXIT CONDITIONS.
;
;	ERROREXIT IF INVALID CHARACTER.
;
	CALL	R$SAVE
	MOV	CD.CHR,R0
	MOV	CD.SRC,R4
	CALL	R$ADDC
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
