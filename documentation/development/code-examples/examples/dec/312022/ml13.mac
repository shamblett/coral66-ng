	.TITLE	ML13..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML13../
;
	.SBTTL	.		CLEAR OUT A CHARACTER STRING.
;
L$CLEAR::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	CHARACTER STRING ADDRESS.
;
;	EXIT CONDITIONS
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.SRC,R0
	CALL	R$CLEAR
	CALL	R$UNSAVE
	RETURN
;
	.END	
;
;
;
