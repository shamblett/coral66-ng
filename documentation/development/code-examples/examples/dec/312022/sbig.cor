   'CORAL' SBIG
 
 
   'COMMON' ('INTEGER''PROCEDURE' BIGS);
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' BIGS;
       'BEGIN'
           'BYTE''ARRAY' STRING [0:1999]:=1,0,0,0;
           'OVERLAY' STRING [0] 'WITH' 'INTEGER' BUFFER LENGTH;
           'OVERLAY' STRING [2] 'WITH' 'INTEGER' LENGTH;
           BUFFER LENGTH:=1996;
           'ANSWER''LOCATION' (STRING[2]);
       'END';
   'END';
   'FINISH'
