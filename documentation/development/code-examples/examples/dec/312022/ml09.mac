	.TITLE	ML09..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML09../
;
	.SBTTL	.		CHARACTER SHIFT LEFT END AROUND.
;
L$SHLE::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	CHARACTER STRING ADDRESS.
;
;	EXIT CONDITIONS
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.SRC,R0
	CALL	R$SHLE
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
