   'CORAL' L11B
   'LIBRARY' (
 
   'COMMENT' BASIC COMPATABLE PROCEDURES;
 
 
   'PROCEDURE' RBLOCK('VALUE''BYTE','BYTE''ARRAY','VALUE''INTEGER','LOCATION''INTEGER','VALUE''INTEGER',
   'LABEL','LABEL'));
   'COMMON' ('INTEGER''PROCEDURE' BLOCKIN ('VALUE''BYTE'));
 
   'COMMENT' GENERAL CORAL DEFINITIONS;
   'INCLUDE' "[200,25]GENDEF.COR"
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' BLOCKIN ('VALUE''BYTE' FILE);
       'BEGIN'
           'BYTE''ARRAY' DATA [0:527]:=0;
           'OVERLAY' DATA[0] 'WITH' 'INTEGER' MAXLEN;
           'OVERLAY' DATA[2] 'WITH' 'INTEGER' LENGTH;
           'OVERLAY' DATA[4] 'WITH' 'BYTE''ARRAY' STRING[0:523];
           MAXLEN := 514;   (FIX MAXIMUM LENGTH)
           RBLOCK(FILE,STRING,512,LENGTH,0,ERRL,EOFL);
           'ANSWER' 'LOCATION' (DATA[2]);
 EOFL:     'ANSWER' EOF;
 ERRL:     'ANSWER' ERROR;
       'END';
   'END';
   'FINISH'
