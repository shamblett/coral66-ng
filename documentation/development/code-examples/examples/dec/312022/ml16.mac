	.TITLE	ML16..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML16../
;
	.SBTTL	.		PAD A CHARACTER STRING.
;
L$PAD::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	INPUT STRING ADDRESS.
;	CD.CNT	=	NUMBER OF CHARACTERS TO PAD WITH OR '0' FOR ALL.
;	CD.CHR	=	CHARACTER TO PAD WITH.
;
;	EXIT CONDITIONS
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.SRC,R0
	MOV	CD.CNT,R1
	MOV	CD.CHR,R2
	CALL	R$PAD
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
