	.TITLE	ML07..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML07../
;
	.SBTTL	.		STRING REVERSAL PROCEDURE.
;
L$REVERSE::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	CHARACTER STRING TO BE REVERSED.
;
;	EXIT CONDITIONS
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.SRC,R0
	CALL	R$REVERSE
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
