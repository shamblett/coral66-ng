'comment'  ----------------------------------------------------------------
 -
 -  Filename:
 -
 -    time.h
 -
 -  Description:
 -
 -    Provides time-related definitions and functions similar to those in
 -    the ANSI C header file <time.h>.
 -
 -  Notes: 
 -
 -    The epoch is Jan 1, 1970. 
 -
 -    32-bit time overflows at Tue Jan 19 03:14:07 2038.
 -
 -  Revision:
 -
 -    $Id:$
 -
 --------------------------------------------------------------------------;

'define' CLOCKS PER SEC "(1000000)";
'define' CLOCKS_PER_SEC "(1000000)";

'external' (

  'long''integer''procedure' clock / "clock";

  'long''floating''procedure' difftime / "difftime" (
    'value''long''integer',
    'value''long''integer');

  'long''integer''procedure' mktime (
    'integer''array');

  'long''integer''procedure' time (
    'location''long''integer');

)

