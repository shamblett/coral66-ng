;
	.TITLE	MGD3..	PARAMETER PASSING DATA AREAS
;
	.IDENT	/MGD3../
;
	.SBTTL	MACRO PARAM PASSING DATA AREAS.
;
;	AUTHOR	:-	J.S.CLIFTON
;	DATE	:-	7TH APRIL 82
;
;
CD.SRC::	.WORD	0	;ADDRESS OF MAIN STRING (SOURCE) OR TABLE ENTRY.
CD.DST::	.WORD	0	;ADDRESS OF SECONDARY STRING (DESTINATION).
CD.CHR::	.WORD	0	;CONTAINS THE FILL OR OPERATION CHARACTER.
CD.CNT::	.WORD	0	;CONTAINS THE LAST INPUT NUMERIC COUNT.
CD.POS::	.WORD	0	;HOLDS THE CHARACTER POSITION FOUND WITHIN STRG.
CD.RES::	.WORD	0	;HOLDS THE RESULT OF PREVIOUS MACRO (COMPARE).
CD.KEY::	.WORD	0	;HOLDS THE LAST TABLE KEY ENTRY.
;
	.END
;
