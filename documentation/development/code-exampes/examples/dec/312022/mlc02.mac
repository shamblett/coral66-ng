	.TITLE	MLC2..	CHARACTER PROCEDURES USING COMMON DICTIONARY.
;
	.IDENT	/MLC2../
;
	.SBTTL	.		MODIFY CHARACTER WITHIN STRING USING LABELS.
;
L$MODC::	;REPLACE A CHARACTER IN STRING USING LABELS.
;
;	ENTRY CONDITIONS
;
;	CD.CHR	=	REPLACEMENT CHARACTER
;	CD.SRC	->	CHARACTER STRING ADDRESS
;	CD.POS	=	CHARACTER POSITION TO MODIFY
;
;	EXIT CONDITIONS
;
;	EXITERROR IF INVALID CONDITIONS.
;
	CALL	R$SAVE
	MOV	CD.CHR,R0
	MOV	CD.SRC,R1
	MOV	CD.POS,R2
	CALL	R$MODC
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
