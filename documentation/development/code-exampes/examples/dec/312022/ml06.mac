	.TITLE	ML06..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML06../
;
	.SBTTL	.		WEDGE ONE STRING WITHIN ANOTHER STRING.
;
L$WEDGE::
;	ENTRY CONDITIONS
;
;	CD.DST	->	MASTER STRING ADDRESS.
;	CD.SRC	->	WEDGE STRING ADDRESS.
;	CD.POS	=	POSITION WHERE INSERT MUST START.
;
;	EXIT CONDITIONS.
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.DST,R1
	MOV	CD.SRC,R2
	MOV	CD.POS,R3
	CALL	R$WEDGE
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
