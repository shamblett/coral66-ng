	.TITLE	ML08..	STRING PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/ML08../
;
	.SBTTL	.		CHARACTER SHIFT RIGHT END AROUND.
;
L$SHRE::
;	ENTRY CONDITIONS
;
;	CD.SRC	->	CHARACTER STRING ADDRESS.
;
;	EXIT CONDITIONS
;
;	NON
;
	CALL	R$SAVE
	MOV	CD.SRC,R0
	CALL	R$SHRE
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
