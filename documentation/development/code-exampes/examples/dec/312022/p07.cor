   'CORAL' P7 RTH MODULE
 
 
   'LIBRARY' ('PROCEDURE' WHERE ('LOCATION''FLOATING','LOCATION''FLOATING','LOCATION''FLOATING');
   'FLOATING''PROCEDURE' DTOR ('VALUE''FLOATING');
   'FLOATING''PROCEDURE' COS ('VALUE''FLOATING');
   'FLOATING''PROCEDURE' SIN ('VALUE''FLOATING'));
   'COMMON' ('PROCEDURE' RTH ('LOCATION''FLOATING','LOCATION''FLOATING'));
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'PROCEDURE' RTH ('LOCATION''FLOATING' X,Y);
       'BEGIN'
           'FLOATING' F, XX, YY, XCENT, YCENT;
           'IF' X<0 
           'THEN'
           'BEGIN'
 
               'COMMENT' WHEN X<0 THEN X,Y ARE R,THETA VALUES;
               X:=-X;  (CORRECT RADIUS VALUE)
               WHERE(XCENT,YCENT,F);  (HOLD PRESENT POSITION)
               XX:=COS(D TO R(Y))*X;  (X REL POSITION)
               YY:=SIN(D TO R(Y))*X;  (Y REL POSITION)
               X:=XX+XCENT;  (LOAD ACTUAL PLOTTER POSITION)
               Y:=YY+YCENT;
           'END';
       'END'OF PROCEDURE RTH R THETA CONVERT;
   'END';
   'FINISH'
