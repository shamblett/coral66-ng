   'CORAL' L12
   'LIBRARY' (
 
   'COMMENT' BASIC COMPATABLE PROCEDURES;
 
 
   'INTEGER''PROCEDURE' LEN('VALUE''INTEGER');
   'PROCEDURE'          WRITEREC ('VALUE''BYTE','LOCATION''INTEGER','VALUE''INTEGER','LOCATION''INTEGER',
   'LABEL'));
   'COMMON' ('INTEGER''PROCEDURE' FILEOUT ('VALUE''BYTE','VALUE''INTEGER'));
 
   'COMMENT' GENERAL CORAL DEFINITIONS;
   'INCLUDE' "[200,25]GENDEF.COR"
   'SEGMENT' RJSSUB
   'BEGIN'
 
 
       'INTEGER''PROCEDURE' FILEOUT('VALUE''BYTE' FILE;
       'VALUE''INTEGER'STRING);
       'BEGIN'
           'INTEGER' DUMMY, ADDRESS;
           ADDRESS:= STRING+2;  (HOLD ADDRESS WHERE CHARACTERS ARE)
           WRITEREC(FILE,ADDRESS,LEN(STRING),DUMMY,ERRL);
           'ANSWER' SUCCESS;
 ERRL:     'ANSWER' ERROR;
       'END';
   'END';
   'FINISH'
