	.TITLE	MC01.. STRING PROCEDURES FOR CORAL IN MACRO
;
	.IDENT	/MC01../
;
	.PAGE
	.SBTTL	LENGTH PROCEDURE (LEN)
;
;
LEN::
	MOV 2(R5),R0		;HOLD ADDRESS OF STRING
	CALL R$ADDRESS		;CHECK IF ADDRESS VALID
	IFSUCCESS	10$	;J IF ADDRESS OK
	CLR R0			;SET LENGTH = 0 IE. ERROR
	RETURN			;EXIT
;
10$:	MOV @2(R5),R0		;R0 HOLDS LENGTH OF CHARACTER STRING
	RETURN			;BYE BYE
;
	.END
;
;
