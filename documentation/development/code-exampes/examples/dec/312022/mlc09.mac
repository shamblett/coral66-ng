	.TITLE	MLC9..	CHARACTER PROCEDURES IN MACRO USING COMMON DICTIONARY.
;
	.IDENT	/MLC9../
;
	.SBTTL	.		COMPARE TWO CHARACTER MATCH.
;
L$CMPC::	;COMPARE TWO CHARACTERS.
;
;	ENTRY CONDITIONS.
;
;	CD.CHR	 =	FIRST CHARACTER (BYTE)
;	CD.CHR+1 =	SECOND CHARACTER (BYTE)
;
;	EXIT CONDITIONS.
;
;	SUCCESS IF CHARACTERS ARE THE SAME.
;
	CALL	R$SAVE
	MOVB	CD.CHR,R1
	MOVB	CD.CHR+1,R2
	CALL	R$CMPC
	CALL	R$UNSAVE
	RETURN
;
	.END
;
;
;
;
