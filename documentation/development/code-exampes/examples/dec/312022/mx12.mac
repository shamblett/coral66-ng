	.PAGE
	.SBTTL	BIT INDICATING MACRO
;
;
	.MACRO DMPBIT FLAG,MASK
;
;
;	THIS MACRO ASSUMES THAT R4 HOLDS THE FLAG BITS
;
	.NCHR NCHR,FLAG			;HOLD NUMBER OF CHARACTERS IN FLAG
	PTEXT <"'FLAG">			;DISPLAY CHARACTERS
.IF LE 7-NCHR
.IFT
	REPCHAR <SPACE>,1		;DEFAULT ASSUME ONE SPACE
.IFF
	REPCHAR <SPACE>,7-NCHR		;FILL AREA TO 7 CHARACTERS
.ENDC
.IF B MASK				;HAS MASK PATTEN BEEN DEFINED
.IFTF
	.EMIT	<MOV R4,-(SP)>		;SAVE DATA PATTEN
.IFF
	.EMIT	<BIC #^C MASK,@SP>	;SHAVE OFF UNWANTED BITS
.IFT
	.EMIT	<BIC #^C FLAG,@SP>	;SHAVE OFF NON FLAG BITS
.IFTF
	.EMIT	<CMP #FLAG,(SP)+> 	;CHECK DATA PATTEN AND FIX STACK
.ENDC
	.EMIT	<BEQ	.+12>		;BYPASS FALSE INDICATOR
	REPCHAR '0,1			;DISPLAY A ZERO
	.EMIT	<BR	.+10>		;BYPASS TRUE INDICATOR
	REPCHAR '1,1			;DISPLAY A ONE
	REPCHAR <SPACE>,3		;TERMINATE WITH 3 SPACES
;
.ENDM	DMPBIT
;
;
	.PAGE
	.SBTTL	SYMBOL INDICATING MACRO
;
;
.MACRO DMPSYM SYMBOL,TYPE,FORMAT
;
	.NCHR NCHR,SYMBOL
	PTEXT <"'SYMBOL">
.IF LE 8.-NCHR
.IFT
	REPCHAR <SPACE>,1		;DEFAULT ASSUME ONE SPACE
.IFF
	REPCHAR <SPACE>,8.-NCHR		;FILL AREA TO 8 CHARACTERS
.ENDC
.IF EQ TYPE-1
	.EMIT	<MOV  R0,-(SP)>		;SAVE REGISTER R0
	.EMIT	<MOVB SYMBOL,R0>
   .IF B FORMAT
	.EMIT	<CALL R$BOCT+2>		;CONVERT VALUE TO ASCII
	.EMIT	<CALL V$TX>		;DISPLAY DATA
	REPCHAR <SPACE>,3		;TERMINATE WITH THREE SPACES
   .ENDC
	.IIF IDN FORMAT,OCT .EMIT <CALL R$BOCT+2	;BYTE PROCESSING ENTRY>
	.IIF IDN FORMAT,OCT .EMIT <CALL V$TX		;OUTPUT VALUE>
	.IIF IDN FORMAT,OCT REPCHAR <SPACE>,3
	.IIF IDN FORMAT,ASC .EMIT <CALL R$BASC>
	.IIF IDN FORMAT,ASC .EMIT <CALL V$TX>
	.IIF IDN FORMAT,ASC REPCHAR <SPACE>,2		;FILLER
	.IIF IDN FORMAT,R50 .EMIT <CALL R$BR50>
	.IIF IDN FORMAT,R50 .EMIT <CALL V$TX>
	.IIF IDN FORMAT,R50 REPCHAR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,DEC .EMIT <CALL R$BDEC>
	.IIF IDN FORMAT,DEC .EMIT <CALL V$TX>
	.EMIT	<MOV (SP)+,R0				;RESTORE REGISTER R0>
.ENDC
;
;
.IF GE TYPE-2
	.IF B FORMAT
	PRINTO SYMBOL
	.ENDC
	.IIF IDN FORMAT,OCT PRINTO SYMBOL
	.IIF IDN FORMAT,ASC PRINTA SYMBOL
	.IIF IDN FORMAT,ASC REPCHAR <SPACE>,2		;FILLER
	.IIF IDN FORMAT,R50 PRINTR SYMBOL
	.IIF IDN FORMAT,R50 REPCHAR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,DEC PRINTD SYMBOL
.ENDC
;
	REPCHAR SPACE,3
;
.ENDM DMPSYM
;
	.PAGE
	.SBTTL	LOCATION INDICATING MACRO
;
;
.MACRO DMPOFF OFFSET,TYPE,FORMAT
;
;	THIS MACRO ASSUMES THAT R4 WILL POINT TO BASE OF THE DATA AREA
;
	.NCHR NCHR,OFFSET
	PTEXT <"'OFFSET">
.IF LE 8.-NCHR
.IFT
	REPCHAR <SPACE>,1				;DEFAULT ASSUME ONE SPACE
.IFF
	REPCHAR <SPACE>,8.-NCHR				;FILL AREA TO 8 CHARACTERS
.ENDC
.IF EQ TYPE-1
	.EMIT	<MOV R0,-(SP)>				;PROTECT REGISTER R0
	.EMIT	<MOVB 'OFFSET(R4),R0>
   .IF B FORMAT
	.EMIT	<CALL R$BOCT+2>				;BYTE PROCESSING ENTRY
	.EMIT	<CALL V$TX>				;OUTPUT DATA
	REPCHAR <SPACE>,3				;THREE FILLER CHARACTERS
   .ENDC
	.IIF IDN FORMAT,OCT .EMIT <CALL R$BOCT+2>
	.IIF IDN FORMAT,OCT .EMIT <CALL V$TX>
	.IIF IDN FORMAT,OCT REPCAHR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,ASC .EMIT <CALL R$BASC>
	.IIF IDN FORMAT,ASC .EMIT <CALL V$TX>
	.IIF IDN FORMAT,ASC REPCHAR <SPACE>,2		;FILLER
	.IIF IDN FORMAT,R50 .EMIT <CALL R$BR50>
	.IIF IDN FORMAT,R50 .EMIT <CALL V$TX>
	.IIF IDN FORMAT,R50 REPCHAR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,DEC .EMIT <CALL R$BDEC>
	.IIF IDN FORMAT,DEC .EMIT <CALL V$TX>
	.EMIT	<MOV (SP)+,R0>				;RESTORE REGISTER R0
.ENDC
;
;
.IF GE TYPE-2
	.IF B FORMAT
	PRINTO 'OFFSET(R4)
	.ENDC
	.IIF IDN FORMAT,OCT PRINTO 'OFFSET(R4)
	.IIF IDN FORMAT,ASC PRINTA 'OFFSET(R4)
	.IIF IDN FORMAT,ASC REPCHAR <SPACE>,2		;FILLER
	.IIF IDN FORMAT,R50 PRINTR 'OFFSET(R4)
	.IIF IDN FORMAT,R50 REPCHAR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,DEC PRINTD 'OFFSET(R4)
.ENDC
;
;
.IF GE TYPE-4
	REPCHAR SPACE,1
	.IF B FORMAT
	PRINTO 'OFFSET+2(R4)
	.ENDC
	.IIF IDN FORMAT,OCT PRINTO 'OFFSET+2(R4)
	.IIF IDN FORMAT,ASC PRINTA 'OFFSET+2(R4)
	.IIF IDN FORMAT,ASC REPCHAR <SPACE>,2		;FILLER
	.IIF IDN FORMAT,R50 PRINTR 'OFFSET+2(R4)
	.IIF IDN FORMAT,R50 REPCHAR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,DEC PRINTD 'OFFSET+2(R4)
.ENDC
;
;
.IF GE TYPE-6
	REPCHAR SPACE,1
	.IF B FORMAT
	PRINTO 'OFFSET+2(R4)
	.ENDC
	.IIF IDN FORMAT,OCT PRINTO 'OFFSET+4(R4)
	.IIF IDN FORMAT,ASC PRINTA 'OFFSET+4(R4)
	.IIF IDN FORMAT,ASC REPCHAR <SPACE>,2		;FILLER
	.IIF IDN FORMAT,R50 PRINTR 'OFFSET+4(R4)
	.IIF IDN FORMAT,R50 REPCHAR <SPACE>,3		;FILLER
	.IIF IDN FORMAT,DEC PRINTD 'OFFSET+4(R4)
.ENDC
;
	REPCHAR SPACE,3
;
.ENDM DMPOFF
;
	.END
