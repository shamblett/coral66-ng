	.MACRO DMPBIT FLAG,MASK; ;R0;	THIS MACRO ASSUMES THAT R4 HOLDS THE FLAG BITS;O5	.NCHR NCHR,FLAG			;HOLD NUMBER OF CHARACTERS IN FLAGT&	PTEXT <"'FLAG">			;DISPLAY CHARACTERS
.IF LE 7-NCHRI.IFT-	REPCHAR <SPACE>,1		;DEFAULT ASSUME ONE SPACET.IFF3	REPCHAR <SPACE>,7-NCHR		;FILL AREA TO 7 CHARACTERS.ENDCC+.IF B MASK				;HAS MASK PATTEN BEEN DEFINEDE.IFTFE(	.EMIT	<MOV R4,-(SP)>		;SAVE DATA PATTEN.IFF2	.EMIT	<BIC #^C MASK,@SP>	;SHAVE OFF UNWANTED BITS.IFT2
	.EMIT	<BIC #^C FLAG,@SP>	;SHAVE OFF NON FLAG BITS.IFTF :	.EMIT	<CMP #FLAG,(SP)+> 	;CHECK DATA PATTEN AND FIX STACK.ENDCN*	.EMIT	<BEQ	.+12>		;BYPASS FALSE INDICATOR	REPCHAR '0,1			;DISPLAY A ZEROH(	.EMIT	<BR	.+10>		;BYPASS TRUE INDICATOR	REPCHAR '1,1			;DISPLAY A ONE,	REPCHAR <SPACE>,3		;TERMINATE WITH 3 SPACES;O
.ENDM	DMPBIT~R

