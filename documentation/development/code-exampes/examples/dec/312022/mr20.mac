	.TITLE  MR20..	DATE  AND  TIME  PROCEDURES
	.IDENT /MR20../
.IF EQ OPSYS-IAS
	.MCALL  GTIM$S
.ENDC
.IF EQ OPSYS-RT11
	.MCALL	.DATE,.GTIM
.ENDC
;
;
	.SBTTL  CONTROL ROUTINE
;
;
R$DAT::			;THIS PROCEDURE REPLYS WITH A
			;STRING CONTAINING THE DATE
 
;	ENTRY CONDITIONS
;	NONE
;
;	EXIT CONDITIONS
;    R0-> STRING CONTAINING THE DATE
;
;
;
.IF EQ OPSYS-RT11
	SAVE R1
	MOV #CMND,R1	;hold data area address
	.DATE		;get date
	MOV R0,@R1	;HOLD DATE PATTEN
	BEQ	10$	;SILLY NO DATE ASSUME (YEAR ZERO JUST LIKE THE FILM)
	BIC #^C37,@R1	;STRIP OFF YEAR BIT
	ADD #72.,(R1)+	;CORRECT DATE (I WONDER WHAT HAPPENS IN 2073 ?)
	ASH #-5,R0	;SLIDE OUT YEAR BIT
	TST (R1)+	;POINT TO DAY SLOT (WHAT A STUPID WAY TO LOAD A DATE)
	MOV R0,@R1	;HOLD DAY MONTH BIT
	BIC #^C37,@R1	;EXTRACT DAY ONTO DAY LOCATION
	ASH #-5,R0	;LEAVE ONLY THE MONTH
	BIC #^C17,R0	;FLUSH RUBBISH
	MOV R0,-(R1)	;PUT MONTH INTO CORRECT HOLE
	UNSAVE R1
.ENDC
	SAVE R4
	MOV #'/,R4	;HOLD DELIMITING CHARACTER
	BR  CMN		;BUILD UP STRING
;
;
;
;
;
;
;
;
R$CLK::			;THIS PROCEDURE REPLY WITH A STRING
			;CONTAINING THE TIME OF DAY OR NIGHT
;		ENTRY CONDITIONS
;		NONE
;
;		EXIT CONDITIONS
;	R0-> STRING CONTAINING THE TIME
;
;
.IF EQ OPSYS-RT11
	SAVE R1			;PROTECT REGISTER
	MOV #CMND,R1		;HOLD DATA AREA ADDRESS
	.GTIM #CMND+4,R1	;GET THE TIME
	MOV (R1)+,R0		;HOLD MS TIME IN TICKS
	MOV @R1,R1		;HOLD LS TIME IN TICKS
	DIV #3000.,R0		;R1 = SECS REMAINDER ,R0 = MINS
	MOV R1,CMND		;SAVE SECS
	CLR R1			;BECAUSE DIVISION AM DUM
	DIV #60.R1		;R1 = MIN REMAINDER, R = HRS (I HOPE)
	MOV R1,CMND+2		;STASH MINS (IN UK ORDER)
	MOV R0,CMND+4		;LIKEWISE WIVE HOURS
	UNSAVE R1
.ENDC
	SAVE  R4
	MOV #':,R4		;HOLD DELIMITING CHARACTER
;	BR  CMN			;BUILD UP STRING
;
;
;
;
;
;
;
;
;
 
 
	.PAGE
	.SBTTL  COMMON ROUTINE + DATA AREA
;
;
;
;
CMN:
;
;	ENTRY CONDITIONS
;	R4 = SEPARATOR CHAR
 
;	EXIT CONDITIONS
;	R0-> STRING ADDRESS
;
	SAVE R1,R2,R3
.IF EQ OPSYS-IAS
	MOV #CMND+G.TIHR,R3	;HOLD ADDRESS OF DATE FIELDS
	GTIM$S #CMND	;GET TIME DATE AND MANY OTHER GOODIES
.ENDC
.IF EQ OPSYS-RT11
	MOV #CMND+6,R3		;POINT TO END OF DATA AREA
.ENDC
	MOV #100$,R1	;HOLD STRING ADDRESS
	MOV #8., (R1)+	;LOAD STRING LENGTH
 ;
	MOV #3,R2	;REPEAT COUNT
 ;
.IF EQ OPSYS-IAS
20$:	CMP R4,#'/	;IS THIS A DATE OPERATION
	BNE	30$	;PROCESS AS TIME
	MOV -(R3),R0	;HOLD DATE UNIT
	BR	40$	;CONVERT TO ASCII
;
30$:	MOV (R3)+,R0	;HOLD TIME UNIT
.ENDC
.IF EQ OPSYS-RT11
20$:	MOV -(R3),R0	;HOLD DATE OR TIME UNIT
.ENDC
40$:	CALL R$BDEC	;CONVERT BINARY VALUE TO STRING
 ;
	MOVB 6(R0),(R1)+;LOAD MS DIGIT
	MOVB 7(R0),(R1)+;LOAD LS DIGIT
	MOVB R4, (R1)+	;STORE SEPERATOR CHARACTER
			;NOTE THIS CHAR IS NOT SEEN IN POSITION 9
	SOB R2,20$	;LOOP 3 TIMES
 ;
	UNSAVE R1,R2,R3	;TAKE THY CONTENTS AND WALK
	UNSAVE R4	;RESTORE SEP CHARACTER STORE
	MOV #100$,R0	;HOLD STRING ADDRESS
	RETURN		;BACK TO CALLING PROGRAM
 ;
 ;
 ;
 ;
 ;
 ;
	.WORD 8.	;TOTAL STRING LENGTH
100$:	.WORD 0		;LENGTH
	.BLKB 10.	;RESERVE CHAR SPACE PLUS HIDDEN CHARACTERS
 ;
.IF EQ OPSYS-IAS
CMND:	.BLKW 8.	;RESERVE SPACE FOR TIME PARAMETERS
.ENDC
.IF EQ OPSYS-RT11
CMND:	.WORD 0,0,0,0	;FOUR BLANKS
.ENDC
 ;
 ;
 ;
 ;
 ;
	.END
 ;
 ;
 ;
 ;
